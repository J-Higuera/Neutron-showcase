import fs from 'node:fs';
import path from 'node:path';
import {
  assertRequiredFields,
  publicBaseUrl,
  readDeployArtifacts,
} from './roster-utils.mjs';

const generatedFile = path.resolve('src/generated-showcase-roster.json');
const sourceArtifacts = readDeployArtifacts();
const generated = JSON.parse(fs.readFileSync(generatedFile, 'utf8'));
const generatedEntries = generated.entries;

if (!Array.isArray(generatedEntries)) {
  throw new Error('Generated roster is missing an entries array.');
}

assertRequiredFields(sourceArtifacts, 'deployArtifacts');
assertRequiredFields(generatedEntries, 'generatedEntries');

if (generatedEntries.length !== 10) {
  throw new Error(`Expected exactly 10 public deploy entries, found ${generatedEntries.length}.`);
}

if (generatedEntries.length !== sourceArtifacts.length) {
  throw new Error(
    `Roster count drift: deploy clone has ${sourceArtifacts.length}, generated has ${generatedEntries.length}.`,
  );
}

sourceArtifacts.forEach((sourceEntry, index) => {
  const generatedEntry = generatedEntries[index];
  for (const field of ['name', 'title', 'slug', 'folder', 'href']) {
    if (generatedEntry[field] !== sourceEntry[field]) {
      throw new Error(
        `${field} drift at index ${index}: expected "${sourceEntry[field]}", got "${generatedEntry[field]}".`,
      );
    }
  }
  if (!generatedEntry.href.startsWith(`${publicBaseUrl}/`) || !generatedEntry.href.endsWith('/')) {
    throw new Error(`Entry ${generatedEntry.slug} href is not an absolute public URL: ${generatedEntry.href}`);
  }
});

console.log(`Public deploy roster verified: ${generatedEntries.length} exact titles + absolute URLs preserved.`);
