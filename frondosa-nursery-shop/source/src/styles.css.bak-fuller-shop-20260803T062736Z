@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,650&family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@500&display=swap');

:root {
  --cream: #f5efdf;
  --paper: #efe2c3;
  --kraft: #cfb884;
  --mist: #dfe9df;
  --leaf: #28583b;
  --moss: #5b7648;
  --soil: #4b3427;
  --terra: #b8613f;
  --graphite: #20231f;
  --muted: #687061;
  --line: rgba(75, 52, 39, .18);
  --shadow: 0 18px 45px rgba(43, 36, 24, .14);
  --radius: 8px;
}

* { box-sizing: border-box; }
html { color-scheme: light; background: var(--cream); overflow-x: clip; }
body {
  margin: 0;
  font-family: Inter, system-ui, sans-serif;
  color: var(--graphite);
  overflow-x: clip;
  background:
    linear-gradient(90deg, rgba(75,52,39,.045) 1px, transparent 1px) 0 0 / 28px 100%,
    radial-gradient(circle at 30% 0, rgba(223,233,223,.9), transparent 34rem),
    var(--cream);
}
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
img { display: block; max-width: 100%; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: .7rem clamp(.9rem, 2vw, 2rem);
  border-bottom: 1px solid var(--line);
  background: rgba(245, 239, 223, .95);
}
.brand {
  border: 0;
  background: transparent;
  text-align: left;
  color: var(--leaf);
}
.brand span {
  display: block;
  font-family: Fraunces, serif;
  font-size: clamp(1.55rem, 1.2rem + 1vw, 2.35rem);
  font-weight: 650;
}
.brand small, .eyebrow, code, .specs dt, .totals dt, .cart-line small, .order-row small {
  font-family: "Roboto Mono", ui-monospace, monospace;
  text-transform: uppercase;
  letter-spacing: 0;
  font-size: .72rem;
}
.site-header nav { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; justify-content: flex-end; }
.site-header nav button, .mobile-tools button, .cart-pill, .clear, .cart-actions button, .confirmation button, .empty button, .profile-card button, .back, .linkish {
  min-height: 2.45rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(255,255,255,.45);
  color: var(--soil);
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  padding: .55rem .75rem;
}
.cart-pill, .primary, .buy-row button {
  background: var(--leaf) !important;
  color: #fff !important;
  border-color: var(--leaf) !important;
}

.catalog-shell {
  display: grid;
  grid-template-columns: minmax(15rem, 19rem) minmax(0, 1fr) minmax(17rem, 21rem);
  gap: clamp(1rem, 2vw, 1.8rem);
  padding: clamp(.85rem, 2vw, 2rem);
  align-items: start;
}
.filter-rail, .care-crate, .care-card, .notes, .box-panel, .page-slip, .checkout-form, .checkout-summary, .profile-card, .orders-log, .order-detail {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(252, 247, 235, .86);
  box-shadow: 0 1px 0 rgba(255,255,255,.7) inset;
}
.filter-rail, .care-crate {
  position: sticky;
  top: 5.25rem;
}
.filter-rail {
  padding: .9rem;
  background:
    linear-gradient(transparent 2.65rem, rgba(75,52,39,.08) 2.7rem, transparent 2.75rem) 0 0 / 100% 3.1rem,
    rgba(239, 226, 195, .72);
}
.rail-title { display: flex; align-items: center; gap: .6rem; color: var(--leaf); margin-bottom: .8rem; }
.rail-title small { display: block; color: var(--muted); }
.mobile-close, .filter-sheet, .mobile-tools, .mobile-cart { display: none; }
.searchbar {
  display: flex;
  align-items: center;
  gap: .45rem;
  min-height: 2.75rem;
  padding: 0 .7rem;
  background: #fff9ed;
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.searchbar input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; }
.tag-stack { border: 0; padding: .65rem 0; margin: 0; }
.tag-stack legend { font-weight: 700; color: var(--soil); margin-bottom: .42rem; }
.check-tag {
  display: flex;
  align-items: center;
  gap: .45rem;
  padding: .37rem .1rem;
  color: #3b4037;
}
.check-tag input { accent-color: var(--leaf); }
.range { width: 100%; accent-color: var(--terra); }
.clear { width: 100%; justify-content: center; margin-top: .6rem; }

.bench { min-width: 0; }
.bench-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: .75rem;
}
.bench-head h1, .detail-shell h1, .page-slip h1, .checkout-grid h1, .account-grid h1, .confirmation h1, .order-detail h1, .account-login h1 {
  font-family: Fraunces, serif;
  font-weight: 650;
  margin: .08rem 0 0;
  color: var(--leaf);
  line-height: 1.04;
}
.bench-head h1 { font-size: clamp(2rem, 1.3rem + 2.1vw, 4rem); }
.eyebrow { margin: 0; color: var(--terra); }
.sort { display: grid; gap: .25rem; min-width: 13rem; color: var(--muted); }
.sort select, .checkout-form input, .checkout-form textarea {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fffbf1;
  min-height: 2.7rem;
  padding: .55rem .7rem;
}
.chips { display: flex; flex-wrap: wrap; gap: .45rem; min-height: 2rem; margin-bottom: .75rem; }
.chips span, .badges span, .pref {
  display: inline-flex;
  border: 1px solid rgba(40,88,59,.18);
  background: rgba(223, 233, 223, .76);
  color: var(--leaf);
  border-radius: 999px;
  padding: .28rem .52rem;
  font-size: .78rem;
  font-weight: 700;
}
.chips button { border: 0; background: transparent; color: var(--terra); font-weight: 700; }

.product-grid, .related-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
  gap: .9rem;
}
.product-card {
  container-type: inline-size;
  border: 1px solid rgba(75,52,39,.2);
  border-radius: var(--radius);
  background:
    linear-gradient(90deg, transparent calc(100% - 1.6rem), rgba(184,97,63,.18) calc(100% - 1.6rem), rgba(184,97,63,.18) calc(100% - 1.5rem), transparent calc(100% - 1.5rem)),
    #fbf5e7;
  overflow: clip;
  box-shadow: var(--shadow);
  animation: fadeTag .22s ease-out both;
}
.photo-button { border: 0; padding: 0; width: 100%; background: var(--mist); }
.photo-button img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: transform .25s ease;
}
.photo-button:hover img { transform: scale(1.025); }
.card-copy { padding: .8rem; }
.card-title { display: flex; justify-content: space-between; gap: .65rem; align-items: start; }
.card-title h2 { margin: 0; font-size: 1.05rem; color: var(--soil); }
.card-title em, .care-card em { color: var(--muted); font-family: Fraunces, serif; }
.card-copy p { color: #485143; line-height: 1.45; }
.badges { display: flex; flex-wrap: wrap; gap: .35rem; }
.badges .safe { background: #e5efe3; color: #1f6638; }
.badges .warn { background: #f3ded2; color: #8b3f27; }
.specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .45rem;
  margin: .8rem 0;
}
.specs div {
  border-left: 3px solid var(--kraft);
  padding-left: .45rem;
}
.specs dd, .specs dt { margin: 0; }
.specs dd { font-size: .84rem; }
.buy-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: .8rem;
  border-top: 1px dashed var(--line);
  padding-top: .7rem;
}
.buy-row strong { font-size: 1.2rem; }
.buy-row small { display: block; color: var(--muted); }
.buy-row button, .primary {
  border: 0;
  border-radius: var(--radius);
  padding: .65rem .85rem;
  min-height: 2.6rem;
  font-weight: 800;
}

.care-crate { overflow: hidden; }
.care-crate img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
.slip, .support-card { padding: .9rem; }
.slip h2 { margin: .15rem 0 .6rem; color: var(--soil); }
.slip p { display: flex; justify-content: space-between; gap: .5rem; }
.crate-total, .totals div {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding: .45rem 0;
  border-top: 1px dashed var(--line);
}
.slip button { width: 100%; min-height: 2.6rem; background: var(--terra); color: #fff; border: 0; border-radius: var(--radius); }
.support-card { display: flex; align-items: start; gap: .55rem; background: rgba(223,233,223,.65); color: var(--leaf); }

.detail-shell, .page-slip, .checkout-grid, .account-grid, .account-login, .confirmation, .order-detail {
  margin: clamp(.9rem, 2vw, 2rem);
}
.back { margin-bottom: .8rem; }
.detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(21rem, .75fr);
  gap: 1rem;
  align-items: start;
}
.gallery, .care-card, .notes, .box-panel { min-width: 0; }
.gallery-main {
  width: 100%;
  aspect-ratio: 1.18 / 1;
  object-fit: cover;
  border-radius: var(--radius);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}
.gallery > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: .55rem; margin-top: .55rem; }
.gallery button { border: 2px solid transparent; padding: 0; border-radius: var(--radius); overflow: hidden; background: transparent; }
.gallery button.active { border-color: var(--terra); }
.gallery button img { aspect-ratio: 1.5 / 1; width: 100%; object-fit: cover; }
.care-card, .notes, .box-panel { padding: 1rem; }
.care-card h1 { font-size: clamp(2.15rem, 1.5rem + 1.9vw, 4.4rem); }
.price-stock { display: flex; align-items: center; gap: .8rem; margin: .75rem 0; }
.price-stock strong { font-size: 1.6rem; }
.price-stock span { color: var(--muted); }
.detail-badges { margin: .8rem 0; }
.qty-row { display: flex; align-items: center; gap: .45rem; margin: 1rem 0; }
.qty-row button {
  width: 2.35rem;
  min-height: 2.35rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: #fff9ed;
}
.qty-row.small { margin: .45rem 0 0; }
.qty-row.small button { width: auto; min-height: 2rem; padding: 0 .55rem; }
.confirm {
  background: #e5efe3;
  border: 1px solid rgba(40,88,59,.25);
  color: var(--leaf);
  padding: .65rem;
  border-radius: var(--radius);
}
.notes dl { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: .6rem; }
.notes dt { font-weight: 800; color: var(--soil); }
.notes dd { margin: .2rem 0 0; color: #4b5547; line-height: 1.45; }
.box-panel p { display: flex; gap: .5rem; align-items: start; color: var(--leaf); }
.related { margin-top: 1.2rem; }

.cart-drawer {
  position: fixed;
  z-index: 50;
  inset: 0 0 0 auto;
  width: min(29rem, 100%);
  padding: 1rem;
  background: #fbf5e7;
  border-left: 1px solid var(--line);
  box-shadow: -22px 0 50px rgba(32,35,31,.18);
  transform: translateX(105%);
  visibility: hidden;
  pointer-events: none;
  transition: transform .25s ease, visibility 0s linear .25s;
  overflow: auto;
}
.cart-drawer.open {
  transform: translateX(0);
  visibility: visible;
  pointer-events: auto;
  transition: transform .25s ease;
}
.drawer-head { display: flex; justify-content: space-between; align-items: center; }
.drawer-head button { border: 0; background: transparent; }
.cart-line {
  display: grid;
  grid-template-columns: 4.5rem minmax(0,1fr) auto;
  gap: .65rem;
  padding: .7rem 0;
  border-top: 1px dashed var(--line);
  align-items: center;
}
.cart-line img {
  width: 4.5rem;
  aspect-ratio: 1;
  object-fit: cover;
  border-radius: var(--radius);
}
.cart-line strong, .cart-line small { display: block; }
.totals {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: .7rem;
  background: #fff9ed;
  margin: .8rem 0;
}
.totals dd { margin: 0; font-weight: 800; }
.totals progress { width: 100%; accent-color: var(--terra); }
.cart-actions { display: flex; gap: .55rem; }
.cart-actions button { flex: 1; justify-content: center; }
.empty {
  min-height: 19rem;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  padding: 1.5rem;
  border: 1px dashed var(--line);
  border-radius: var(--radius);
  background: rgba(255,251,241,.65);
}
.empty h2, .empty h1 { margin: .4rem 0; color: var(--leaf); }
.skeleton {
  min-height: 24rem;
  border-radius: var(--radius);
  background: linear-gradient(100deg, rgba(207,184,132,.35), rgba(255,255,255,.58), rgba(207,184,132,.35));
  background-size: 220% 100%;
  animation: shimmer 1.2s infinite;
}
.skeleton.line { min-height: 4.5rem; margin: .7rem 0; }

.page-slip { max-width: 70rem; padding: 1.2rem; }
.checkout-grid, .account-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(22rem, .65fr);
  gap: 1rem;
  align-items: start;
}
.checkout-form, .checkout-summary, .profile-card, .orders-log { padding: 1rem; }
.checkout-form { display: grid; gap: .8rem; }
.checkout-form label { display: grid; gap: .28rem; font-weight: 700; }
.checkout-form textarea { min-height: 6rem; resize: vertical; }
.demo-pay {
  border-left: 4px solid var(--terra);
  padding: .65rem .75rem;
  background: rgba(207,184,132,.3);
  font-weight: 800;
}
.field-error, .error-summary { color: #8b2d20; }
.error-summary {
  border: 1px solid #b8613f;
  background: #f7ddd0;
  padding: .7rem;
  border-radius: var(--radius);
}
.payment-choice {
  display: flex !important;
  grid-template-columns: auto 1fr;
  align-items: center;
}
.checkout-summary .cart-actions, .checkout-summary .qty-row button, .checkout-summary .qty-row + button { display: none; }

.account-login, .confirmation {
  max-width: 42rem;
  padding: 1.4rem;
  background: rgba(252,247,235,.9);
  border: 1px solid var(--line);
  border-radius: var(--radius);
}
.account-login code { display: inline-block; padding: .55rem; background: var(--paper); margin: .7rem 0; }
.pref { margin: .25rem .25rem 0 0; }
.order-row {
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0,1fr) auto auto;
  gap: 1rem;
  align-items: center;
  text-align: left;
  padding: .8rem 0;
  border: 0;
  border-top: 1px dashed var(--line);
  background: transparent;
}
.order-detail { padding: 1rem; }
.order-layout { display: grid; grid-template-columns: minmax(0,1fr) minmax(18rem,.7fr); gap: 1rem; }
.timeline {
  list-style: none;
  margin: 0;
  padding: 0;
}
.timeline li {
  position: relative;
  padding: 0 0 .9rem 1.2rem;
  border-left: 2px solid var(--kraft);
}
.timeline li::before {
  content: '';
  position: absolute;
  left: -.42rem;
  top: .1rem;
  width: .7rem;
  height: .7rem;
  border-radius: 50%;
  background: var(--leaf);
}
.timeline strong, .timeline small { display: block; }
.fine { color: var(--muted); font-size: .88rem; line-height: 1.45; }

@keyframes fadeTag { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@keyframes shimmer { to { background-position: -220% 0; } }

@media (max-width: 74rem) {
  .catalog-shell { grid-template-columns: minmax(0, 1fr); padding-bottom: 5rem; }
  .catalog-shell > .filter-rail, .care-crate { display: none; }
  .mobile-tools {
    display: flex;
    gap: .55rem;
    position: sticky;
    top: 4.2rem;
    z-index: 20;
    background: var(--cream);
    padding: .6rem 0;
  }
  .mobile-tools .searchbar { flex: 1; }
  .filter-sheet {
    display: block;
    position: fixed;
    z-index: 60;
    inset: 0 auto 0 0;
    width: min(100vw, 22rem);
    max-width: 100vw;
    overflow-x: clip;
    transform: translateX(-100%);
    visibility: hidden;
    pointer-events: none;
    transition: transform .25s ease, visibility 0s linear .25s;
  }
  .filter-sheet.open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
    transition: transform .25s ease;
  }
  .filter-sheet .filter-rail {
    display: block;
    position: relative;
    top: 0;
    width: 100%;
    max-width: 100%;
    height: 100svh;
    min-height: 100%;
    overflow: auto;
    overflow-x: clip;
  }
  .mobile-close { display: inline-flex; margin-left: auto; border: 0; background: transparent; }
  .scrim { position: fixed; inset: 0; z-index: 55; border: 0; background: rgba(32,35,31,.28); }
  .desktop-search { display: none; }
  .detail-grid, .checkout-grid, .account-grid, .order-layout { grid-template-columns: 1fr; }
  .notes dl { grid-template-columns: 1fr; }
  .mobile-cart {
    display: flex;
    position: fixed;
    z-index: 40;
    bottom: .8rem;
    left: 50%;
    transform: translateX(-50%);
    gap: .5rem;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    width: min(calc(100% - 1.5rem), 28rem);
    border: 0;
    border-radius: var(--radius);
    background: var(--leaf);
    color: #fff;
    box-shadow: var(--shadow);
  }
}

@media (max-width: 42rem) {
  .site-header { align-items: start; }
  .site-header nav button:not(.cart-pill) { font-size: 0; padding: .55rem; }
  .site-header nav button svg { margin: 0; }
  .brand span { font-size: 1.55rem; }
  .bench-head { display: block; }
  .bench-head h1 { font-size: 2rem; }
  .sort { margin-top: .75rem; width: 100%; }
  .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .55rem; }
  .card-copy { padding: .58rem; }
  .card-title { display: block; }
  .card-title h2 { font-size: .92rem; }
  .card-title em, .card-copy p, .badges span, .specs, .buy-row small { font-size: .72rem; }
  .badges span:nth-child(2), .specs { display: none; }
  .buy-row { display: grid; gap: .45rem; }
  .buy-row button { width: 100%; }
  .detail-shell, .page-slip, .checkout-grid, .account-grid, .account-login, .confirmation, .order-detail { margin: .7rem; }
  .cart-line { grid-template-columns: 3.8rem minmax(0,1fr); }
  .cart-line b { grid-column: 2; }
}

@media (min-width: 100rem) {
  .catalog-shell { grid-template-columns: 20rem minmax(0, 1fr) 22rem; }
  .product-grid { grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr)); }
  .detail-shell { margin-inline: clamp(2rem, 4vw, 5rem); }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .001ms !important;
  }
}
