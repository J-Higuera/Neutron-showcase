@layer reset, base, layout, components, motion;

@layer reset {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 0;
    overflow-x: clip;
    scroll-behavior: smooth;
  }

  body,
  h1,
  h2,
  h3,
  p,
  figure,
  ol,
  ul,
  dl,
  dd {
    margin: 0;
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }
}

@layer base {
  :root {
    --charcoal: #090706;
    --soot: #120d0a;
    --bench: #21140e;
    --umber: #57311d;
    --oxide: #9f4723;
    --ember: #ef7b28;
    --honey: #ffbd64;
    --pale-fire: #ffe4ad;
    --ash: #c8c1b4;
    --ash-dim: #827a70;
    --smoke: #182626;
    --teal: #70aaa7;
    --aqua: #b9e1da;
    --ink: #f6eee0;
    --muted: #cdbda4;
    --line: color-mix(in srgb, var(--honey) 25%, transparent);
    --gutter: clamp(1rem, 4vw, 5rem);
    --space-1: clamp(0.5rem, 0.4rem + 0.4vi, 0.85rem);
    --space-2: clamp(0.85rem, 0.65rem + 0.9vi, 1.5rem);
    --space-3: clamp(1.25rem, 0.9rem + 1.6vi, 2.5rem);
    --space-4: clamp(2rem, 1.3rem + 3.2vi, 4.75rem);
    --space-5: clamp(3.4rem, 2.2rem + 5vi, 8rem);
    --display: 'Fraunces', Georgia, serif;
    --sans: 'IBM Plex Sans', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --scroll-progress: 0;
  }

  body {
    min-width: 0;
    overflow-x: clip;
    color: var(--ink);
    background:
      radial-gradient(circle at 18% 8%, rgb(239 123 40 / 0.2), transparent 20rem),
      linear-gradient(180deg, var(--charcoal), var(--soot) 34%, #111719 70%, #0b0f0f);
    font-family: var(--sans);
    font-size: clamp(1rem, 0.96rem + 0.18vi, 1.13rem);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    content: '';
    opacity: 0.34;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.028) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size: 3.2rem 3.2rem;
    mask-image: linear-gradient(to bottom, #000, transparent 82%);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 600;
    line-height: 0.98;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(3.1rem, 2.05rem + 3.45vi, 6.35rem);
    max-width: 12em;
  }

  h2 {
    font-size: clamp(2.35rem, 1.72rem + 2.55vi, 5.2rem);
  }

  h3 {
    font-size: clamp(1.45rem, 1.18rem + 0.9vi, 2.2rem);
  }

  p {
    max-width: 68ch;
    text-wrap: pretty;
  }

  :focus-visible {
    outline: 2px solid var(--aqua);
    outline-offset: 4px;
  }

  ::selection {
    color: var(--charcoal);
    background: var(--honey);
  }
}

@layer layout {
  .skip-link {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 90;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    color: var(--honey);
    background: var(--charcoal);
    white-space: nowrap;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    inset-block-start: max(0.75rem, env(safe-area-inset-top));
    inset-inline-start: 0.75rem;
    width: auto;
    height: auto;
    padding: 0.42rem 0.62rem;
    border: 1px solid rgb(255 189 100 / 0.62);
    clip-path: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    line-height: 1.2;
  }

  .scroll-heat {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 80;
    height: 3px;
    pointer-events: none;
    background: linear-gradient(90deg, var(--ember), var(--honey), var(--teal));
    transform: scaleX(var(--scroll-progress));
    transform-origin: left;
  }

  .site-header {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 2.3vw, 2.2rem) var(--gutter);
  }

  .brand-mark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.36rem;
    font-family: var(--display);
    font-size: clamp(1.05rem, 0.92rem + 0.45vi, 1.42rem);
    letter-spacing: 0;
  }

  .brand-mark i {
    color: var(--honey);
    font-style: normal;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: clamp(1rem, 2vw, 2.4rem);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  main {
    overflow: clip;
  }

  section {
    position: relative;
    padding: var(--space-5) var(--gutter);
    overflow: clip;
  }

  .section-hot {
    background:
      radial-gradient(circle at 85% 0%, rgb(239 123 40 / 0.18), transparent 24rem),
      linear-gradient(180deg, rgb(18 13 10 / 0.8), rgb(12 9 7 / 0.98));
  }

  .section-bench {
    background:
      linear-gradient(90deg, rgb(31 18 12 / 0.74), transparent 55%),
      var(--soot);
  }

  .section-ash {
    background:
      radial-gradient(circle at 20% 0%, rgb(185 225 218 / 0.08), transparent 22rem),
      #111414;
  }

  .section-cool {
    background:
      radial-gradient(circle at 82% 18%, rgb(112 170 167 / 0.12), transparent 26rem),
      linear-gradient(180deg, #101717, #090d0d);
  }

  .hero {
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-block: clamp(6.75rem, 12svh, 10rem) clamp(2rem, 7svh, 5rem);
  }

  .hero-media,
  .hero-scrim {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    z-index: 0;
    aspect-ratio: auto;
  }

  .hero-media img {
    object-position: 55% 50%;
  }

  .hero-media::after {
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    content: '';
    background: linear-gradient(to top, var(--charcoal), transparent);
  }

  .hero-scrim {
    z-index: 1;
    background:
      radial-gradient(circle at 72% 43%, rgb(255 157 62 / 0.22), transparent 15rem),
      linear-gradient(90deg, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.48) 48%, rgb(0 0 0 / 0.18)),
      linear-gradient(180deg, rgb(0 0 0 / 0.52), rgb(0 0 0 / 0.18) 45%, rgb(0 0 0 / 0.76));
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-2);
    width: min(61rem, 100%);
  }

  .hero-copy p:not(.eyebrow) {
    color: var(--muted);
    font-size: clamp(1.05rem, 0.95rem + 0.45vi, 1.42rem);
  }

  .bench-note {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.15rem;
    width: min(100%, 28rem);
    margin-block-start: var(--space-4);
    padding: 1rem 1.1rem;
    border-inline-start: 1px solid var(--honey);
    color: var(--muted);
    background: linear-gradient(90deg, rgb(255 189 100 / 0.12), rgb(0 0 0 / 0.16));
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .bench-note strong {
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 500;
  }

  .makers,
  .objects,
  .workshops,
  .final-inquiry {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .makers-copy,
  .objects-copy,
  .workshops-copy,
  .inquiry-copy {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .section-intro {
    display: grid;
    gap: var(--space-2);
    width: min(100%, 72rem);
    margin-block-end: var(--space-4);
  }

  .evidence-wall {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .objects {
    align-items: stretch;
  }

  .commissions {
    display: grid;
    gap: var(--space-3);
  }

  .inquiry-paths {
    display: grid;
    gap: 1px;
    background: rgb(255 189 100 / 0.18);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem var(--gutter);
    color: var(--ash-dim);
    background: var(--charcoal);
    font-family: var(--mono);
    font-size: 0.74rem;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .nav-links {
      display: flex;
    }

    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.36fr);
      gap: var(--space-3);
    }

    .hero-copy {
      grid-column: 1;
      grid-row: 1;
      align-self: end;
    }

    .bench-note {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      justify-self: end;
      margin-block-start: 0;
    }

    .makers {
      grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
    }

    .objects {
      grid-template-columns: minmax(21rem, 0.82fr) minmax(0, 1.18fr);
    }

    .workshops {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.75fr);
    }

    .final-inquiry {
      grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.68fr);
      align-items: end;
    }

    .final-media {
      grid-row: 1 / span 2;
    }
  }

  @media (min-width: 72rem) {
    .hero {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(1.25rem, 2vw, 2.5rem);
    }

    .hero-media {
      position: relative;
      z-index: 2;
      grid-column: 8 / span 5;
      grid-row: 1 / span 2;
      align-self: end;
      height: min(64svh, 46rem);
      min-height: 32rem;
      box-shadow:
        inset 0 0 0 1px rgb(255 189 100 / 0.2),
        0 2rem 6rem rgb(0 0 0 / 0.48),
        -2rem 0 8rem rgb(239 123 40 / 0.1);
    }

    .hero-media img {
      object-position: 48% 50%;
    }

    .hero-scrim {
      z-index: 1;
      background:
        radial-gradient(circle at 68% 35%, rgb(255 157 62 / 0.2), transparent 18rem),
        linear-gradient(90deg, rgb(0 0 0 / 0.7), rgb(0 0 0 / 0.38) 50%, rgb(0 0 0 / 0.76)),
        linear-gradient(180deg, rgb(0 0 0 / 0.44), rgb(0 0 0 / 0.12) 45%, rgb(0 0 0 / 0.72));
    }

    .hero-copy {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
      width: min(100%, 74rem);
    }

    .hero-copy h1 {
      max-width: 12.6em;
    }

    .hero-copy p:not(.eyebrow) {
      max-width: 54rem;
    }

    .bench-note {
      grid-column: 8 / span 5;
      grid-row: 2;
      width: min(100%, 34rem);
      align-self: end;
      justify-self: end;
      margin: 0 1.1rem 1.1rem 0;
      transform: none;
      background: linear-gradient(90deg, rgb(18 13 10 / 0.86), rgb(0 0 0 / 0.52));
    }

    .evidence-wall {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: stretch;
    }

    .evidence-item {
      grid-column: span 4;
    }

    .evidence-large {
      grid-column: span 7;
      grid-row: span 2;
    }

    .evidence-wide {
      grid-column: span 5;
    }

    .inquiry-paths {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
}

@layer components {
  .eyebrow,
  .meta-chip,
  figcaption,
  .path span {
    color: var(--honey);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .eyebrow {
    letter-spacing: 0.08em;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    align-items: center;
    margin-block-start: 0.4rem;
  }

  .button {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    padding: 0.78rem 1rem;
    border: 1px solid transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    transition:
      transform 180ms var(--ease),
      border-color 180ms var(--ease),
      background-color 180ms var(--ease);
  }

  .button-primary {
    color: var(--charcoal);
    background: linear-gradient(180deg, var(--pale-fire), var(--honey));
  }

  .button-secondary {
    border-color: rgb(255 189 100 / 0.42);
    background: rgb(9 7 6 / 0.62);
  }

  .media-frame,
  .evidence-item {
    position: relative;
    overflow: hidden;
    background: var(--bench);
    box-shadow:
      inset 0 0 0 1px rgb(255 189 100 / 0.18),
      0 1.2rem 3rem rgb(0 0 0 / 0.32);
  }

  .media-frame::before,
  .evidence-item::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    content: '';
    background:
      linear-gradient(135deg, rgb(255 189 100 / 0.2), transparent 34%),
      linear-gradient(0deg, rgb(0 0 0 / 0.34), transparent 45%);
    opacity: 0.82;
  }

  .makers-image {
    min-height: min(75svh, 48rem);
    clip-path: polygon(0 0, 100% 4%, 92% 100%, 0 96%);
  }

  .role-list {
    display: grid;
    gap: 1px;
    margin-block-start: var(--space-1);
    background: rgb(255 189 100 / 0.18);
  }

  .role-list div,
  .path {
    display: grid;
    gap: 0.35rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: rgb(18 13 10 / 0.88);
  }

  .role-list dt {
    color: var(--pale-fire);
    font-family: var(--display);
    font-size: 1.35rem;
    line-height: 1;
  }

  .role-list dd,
  .path p,
  .proof-note,
  .safety-note {
    color: var(--muted);
  }

  .rail-shell {
    position: relative;
    max-width: 100%;
  }

  .pipe-line {
    position: absolute;
    inset-block: 1.4rem auto;
    inset-inline: 0;
    display: none;
    height: 0.45rem;
    overflow: hidden;
    background: linear-gradient(90deg, #31231b, #71513e, #1f2929);
  }

  .pipe-core,
  .pipe-glow {
    position: absolute;
    inset: 0;
    transform-origin: left;
  }

  .pipe-core {
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.12) 0 1px, transparent 1px 4rem);
  }

  .pipe-glow {
    --rail-progress: 0;
    background: linear-gradient(90deg, var(--ember), var(--honey), var(--teal));
    transform: scaleX(calc((var(--rail-progress) * 0.98) + 0.02));
    transition: transform 620ms var(--ease);
  }

  .station-track {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }

  .station {
    position: relative;
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding-inline-start: 1.2rem;
    border-inline-start: 2px solid rgb(255 189 100 / 0.38);
  }

  .station::before {
    position: absolute;
    inset-block-start: 0.15rem;
    inset-inline-start: -0.52rem;
    width: 0.9rem;
    aspect-ratio: 1;
    border-radius: 50%;
    content: '';
    background: var(--honey);
    box-shadow: 0 0 1.2rem rgb(239 123 40 / 0.68);
  }

  .station::after {
    color: rgb(255 189 100 / 0.4);
    content: attr(data-step);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .station-media {
    aspect-ratio: 4 / 3;
  }

  .station-copy {
    display: grid;
    gap: 0.75rem;
  }

  .station-copy p {
    color: var(--muted);
  }

  .evidence-item {
    display: grid;
    min-height: 18rem;
  }

  .evidence-item img {
    grid-area: 1 / 1;
  }

  .evidence-item figcaption {
    position: relative;
    z-index: 2;
    grid-area: 1 / 1;
    align-self: end;
    padding: 1rem;
    color: var(--ink);
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), transparent);
  }

  .evidence-large {
    min-height: clamp(24rem, 46vw, 50rem);
  }

  .evidence-wide {
    min-height: clamp(18rem, 28vw, 30rem);
  }

  .objects-photo,
  .workshops-photo,
  .final-media {
    min-height: clamp(24rem, 48vw, 47rem);
  }

  .objects-photo {
    clip-path: inset(0 0 0 7%);
  }

  .objects-photo figcaption {
    position: absolute;
    inset-inline: 7% 0;
    inset-block-end: 0;
    z-index: 2;
    padding: 0.9rem 1rem;
    color: var(--ink);
    background: rgb(0 0 0 / 0.58);
  }

  .object-list,
  .workshop-list {
    display: grid;
    gap: 0.8rem;
    padding: 0;
    list-style: none;
  }

  .object-list li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.7rem;
    border-block-end: 1px solid rgb(255 255 255 / 0.11);
  }

  .object-list strong {
    color: var(--pale-fire);
    font-family: var(--display);
    font-size: 1.3rem;
    line-height: 1.1;
  }

  .object-list span,
  .workshop-list {
    color: var(--muted);
  }

  .path {
    min-height: 13rem;
  }

  .path h3 {
    font-size: clamp(1.3rem, 1.12rem + 0.7vi, 1.9rem);
  }

  .commission-flow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .commission-flow li {
    padding: 0.5rem 0.7rem;
    color: var(--aqua);
    background: rgb(112 170 167 / 0.1);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .workshops-photo {
    clip-path: polygon(0 6%, 100% 0, 100% 94%, 7% 100%);
  }

  .workshops-copy .button {
    justify-self: start;
    margin-block-start: 0.35rem;
  }

  .final-media {
    opacity: 0.78;
  }

  .inquiry-form {
    display: grid;
    gap: 0.65rem;
    width: 100%;
    padding: clamp(1rem, 2.4vw, 1.8rem);
    background:
      linear-gradient(135deg, rgb(185 225 218 / 0.08), transparent 42%),
      rgb(9 13 13 / 0.92);
    box-shadow:
      inset 0 1px 0 rgb(185 225 218 / 0.2),
      inset 0 -1px 0 rgb(255 189 100 / 0.13);
  }

  .inquiry-form label {
    color: var(--pale-fire);
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
  }

  .inquiry-form input,
  .inquiry-form select,
  .inquiry-form textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid rgb(200 193 180 / 0.28);
    border-radius: 0;
    color: var(--ink);
    background: rgb(255 255 255 / 0.055);
  }

  .inquiry-form input,
  .inquiry-form select {
    min-height: 2.8rem;
    padding: 0 0.8rem;
  }

  .inquiry-form textarea {
    resize: vertical;
    padding: 0.75rem 0.8rem;
  }

  .inquiry-form p {
    color: var(--ash-dim);
    font-size: 0.86rem;
  }

  .inquiry-form button {
    justify-self: start;
    margin-block-start: 0.35rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .button:hover {
      transform: translateY(-2px);
    }

    .media-frame:hover::before,
    .evidence-item:hover::before {
      opacity: 1;
    }
  }

  @media (min-width: 64rem) {
    .station-track {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1rem;
      padding-block-start: 3.2rem;
    }

    .pipe-line {
      display: block;
    }

    .station {
      padding: 0;
      border-inline-start: 0;
      opacity: 0.72;
      transition: opacity 420ms var(--ease), transform 520ms var(--ease);
    }

    .station::before {
      inset-block-start: -2.25rem;
      inset-inline-start: 1rem;
    }

    .station::after {
      position: absolute;
      inset-block-start: -2.65rem;
      inset-inline-start: 2.25rem;
    }

    .station.is-active,
    .station.is-passed {
      opacity: 1;
    }

    .station:nth-child(even) {
      transform: translateY(2.1rem);
    }

    .station:nth-child(even).is-active {
      transform: translateY(1.35rem);
    }

    .station-media {
      aspect-ratio: 1 / 1;
    }

    .station-copy {
      gap: 0.55rem;
    }

    .station-copy p {
      font-size: 0.93rem;
      line-height: 1.48;
    }

    .meta-chip {
      font-size: 0.63rem;
    }

    .station h3 {
      font-size: clamp(1.28rem, 1.05rem + 0.8vi, 1.8rem);
    }
  }
}

@layer motion {
  @media (prefers-reduced-motion: no-preference) {
    .js .reveal {
      opacity: 0;
      transform: translateY(1.4rem);
      transition:
        opacity 760ms var(--ease),
        transform 760ms var(--ease);
    }

    .js .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .hero-media img {
      animation: furnace-breath 8s ease-in-out infinite alternate;
    }

    @keyframes furnace-breath {
      from {
        transform: scale(1.01);
      }
      to {
        transform: scale(1.045);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }

    .reveal {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 42rem) {
    html,
    body {
      overflow-x: clip;
    }

    .site-header {
      align-items: flex-start;
    }

    .hero {
      min-height: auto;
      padding-block-start: 6rem;
    }

    h1 {
      font-size: clamp(2.75rem, 2.05rem + 8vi, 4.5rem);
    }

    .cta-row,
    .button {
      width: 100%;
    }

    .makers-image,
    .objects-photo,
    .workshops-photo {
      clip-path: none;
    }

    .objects-photo figcaption {
      inset-inline: 0;
    }

    .site-footer {
      display: grid;
    }
  }
}
