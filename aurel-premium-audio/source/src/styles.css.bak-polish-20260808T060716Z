:root {
  color-scheme: light;
  --ivory: #f4f0e7;
  --stone: #e3ded2;
  --paper: #fbf8f0;
  --graphite: #171717;
  --muted: #6c665d;
  --rule: rgba(23, 23, 23, 0.14);
  --champagne: #b89d6a;
  --copper: #986847;
  --signal: #567a8b;
  --glass: rgba(28, 31, 31, 0.72);
  --shadow: 0 24px 70px rgba(39, 32, 24, 0.16);
  --sans: "Satoshi", "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 5.5rem;
}

body {
  margin: 0;
  min-width: 320px;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 12% 8%, rgba(184, 157, 106, 0.18), transparent 28rem),
    linear-gradient(115deg, rgba(255, 255, 255, 0.42), transparent 32rem),
    var(--ivory);
  color: var(--graphite);
  font-family: var(--sans);
  font-size: 1rem;
  line-height: 1.55;
  letter-spacing: 0;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.18;
  background-image:
    linear-gradient(rgba(23, 23, 23, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(23, 23, 23, 0.035) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: linear-gradient(to bottom, black, transparent 72%);
}

body,
button,
input,
select {
  font: inherit;
}

a {
  color: inherit;
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.25em;
}

img,
canvas,
svg {
  display: block;
  max-width: 100%;
}

button,
input,
select {
  border-radius: 0;
}

:focus-visible {
  outline: 2px solid var(--signal);
  outline-offset: 4px;
}

.skip-link {
  position: fixed;
  top: 1rem;
  left: 1rem;
  z-index: 100;
  transform: translateY(-150%);
  background: var(--graphite);
  color: var(--paper);
  padding: 0.7rem 0.9rem;
}

.skip-link:focus {
  transform: translateY(0);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(23, 23, 23, 0.1);
  background: rgba(244, 240, 231, 0.82);
  backdrop-filter: blur(18px);
}

.nav-shell {
  width: min(1180px, calc(100% - 2rem));
  min-height: 4.75rem;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.brand {
  font-weight: 900;
  font-size: 1.05rem;
  letter-spacing: 0.22em;
  text-decoration: none;
}

.nav-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: clamp(0.7rem, 2vw, 1.65rem);
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
}

.nav-links a {
  text-decoration: none;
}

.nav-links a:hover {
  color: var(--graphite);
}

.section-pad {
  width: min(1180px, calc(100% - 2rem));
  margin-inline: auto;
  padding-block: clamp(4.25rem, 8vw, 8rem);
}

.hero {
  min-height: calc(100svh - 4.75rem);
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  align-items: center;
  gap: clamp(2rem, 5vw, 5rem);
  padding-top: clamp(2rem, 5vw, 4rem);
}

.hero-copy,
.product-stage-wrap,
.section-heading,
.audition-copy {
  min-width: 0;
}

.eyebrow {
  margin: 0 0 1rem;
  color: var(--copper);
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
h3 {
  line-height: 0.98;
  letter-spacing: 0;
}

h1 {
  max-width: 12ch;
  margin-bottom: 1.35rem;
  font-size: clamp(3.1rem, 5.3vw + 0.7rem, 5.95rem);
  font-weight: 900;
}

h2 {
  max-width: 13ch;
  margin-bottom: 0;
  font-size: clamp(2.4rem, 4vw + 1rem, 5.2rem);
  font-weight: 900;
}

h3 {
  margin-bottom: 0.7rem;
  font-size: clamp(1.08rem, 0.5vw + 1rem, 1.35rem);
  font-weight: 700;
}

.hero-lede {
  max-width: 36rem;
  margin-bottom: 1.8rem;
  color: #49443d;
  font-size: clamp(1.08rem, 0.55vw + 1rem, 1.38rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.85rem;
  margin-bottom: 2.2rem;
}

.button {
  min-height: 2.9rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  min-width: 0;
  border: 1px solid var(--graphite);
  padding: 0.75rem 1rem;
  font-weight: 700;
  line-height: 1.15;
  text-align: center;
  text-decoration: none;
  transition: transform 180ms ease, background 180ms ease, color 180ms ease;
  cursor: pointer;
}

.button:hover {
  transform: translateY(-2px);
}

.button-primary {
  background: var(--graphite);
  color: var(--paper);
}

.button-primary span {
  transition: transform 180ms ease;
}

.button-primary:hover span {
  transform: translate(2px, -2px);
}

.button-secondary {
  background: rgba(251, 248, 240, 0.38);
}

.hero-notes {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  max-width: 42rem;
  margin: 0;
  border: 1px solid var(--rule);
  background: var(--rule);
}

.hero-notes div {
  min-width: 0;
  background: rgba(251, 248, 240, 0.48);
  padding: 1rem;
}

.hero-notes dt {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
}

.hero-notes dd {
  margin: 0.25rem 0 0;
  font-weight: 700;
}

.product-stage {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1.02;
  max-height: min(68svh, 760px);
  overflow: hidden;
  border: 1px solid rgba(23, 23, 23, 0.13);
  background:
    linear-gradient(150deg, rgba(255, 255, 255, 0.52), transparent 40%),
    radial-gradient(circle at 52% 48%, rgba(184, 157, 106, 0.24), transparent 33%),
    linear-gradient(180deg, rgba(227, 222, 210, 0.4), rgba(205, 197, 181, 0.42));
  box-shadow: var(--shadow);
  isolation: isolate;
}

.product-stage::before {
  content: "";
  position: absolute;
  inset: 8%;
  border: 1px solid rgba(23, 23, 23, 0.09);
  pointer-events: none;
}

#product-canvas {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.webgl-fallback {
  position: absolute;
  inset: 15% 11% 11%;
  z-index: 0;
  opacity: 1;
  transition: opacity 240ms ease;
  pointer-events: none;
}

.product-stage.webgl-ready .webgl-fallback {
  opacity: 0;
}

.product-stage.webgl-unavailable #product-canvas {
  opacity: 0;
}

.fallback-band {
  position: absolute;
  left: 18%;
  right: 18%;
  top: 1%;
  height: 42%;
  border: 16px solid #a99b80;
  border-bottom: 0;
  border-radius: 52% 52% 0 0 / 100% 100% 0 0;
  box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.24);
}

.fallback-cup {
  position: absolute;
  top: 33%;
  width: 24%;
  aspect-ratio: 0.72;
  border: 14px solid #b9a875;
  border-radius: 42%;
  background:
    repeating-linear-gradient(90deg, rgba(151, 102, 67, 0.9) 0 2px, transparent 2px 15px),
    #20201e;
  box-shadow: 0 34px 55px rgba(23, 23, 23, 0.18);
}

.fallback-cup.left {
  left: 19%;
}

.fallback-cup.right {
  right: 19%;
}

.fallback-amp {
  position: absolute;
  left: 25%;
  right: 25%;
  bottom: 0;
  height: 17%;
  border: 1px solid rgba(23, 23, 23, 0.18);
  background:
    radial-gradient(circle at 72% 50%, #a57145 0 12%, #151515 13% 22%, transparent 23%),
    linear-gradient(90deg, #151515 0 38%, #232826 38% 62%, #151515 62%);
  box-shadow: 0 26px 45px rgba(23, 23, 23, 0.18);
}

.stage-vignette {
  position: absolute;
  inset: auto 8% 6% 8%;
  height: 18%;
  background: radial-gradient(ellipse, rgba(23, 23, 23, 0.22), transparent 66%);
  filter: blur(10px);
  pointer-events: none;
}

.callouts {
  position: absolute;
  inset: 0;
  z-index: 2;
  margin: 0;
  padding: 0;
  list-style: none;
  pointer-events: none;
}

.callout {
  position: absolute;
  width: min(13.5rem, 38%);
  color: var(--graphite);
  font-family: var(--mono);
  font-size: clamp(0.62rem, 0.3vw + 0.58rem, 0.76rem);
  line-height: 1.35;
}

.callout::before {
  content: "";
  position: absolute;
  top: 0.7rem;
  width: clamp(2.8rem, 7vw, 5.5rem);
  height: 1px;
  background: rgba(23, 23, 23, 0.38);
}

.callout strong,
.callout span:last-child {
  display: block;
}

.callout strong {
  font-weight: 500;
}

.callout span:last-child {
  color: var(--muted);
}

.pin {
  position: absolute;
  top: 0.45rem;
  width: 0.55rem;
  height: 0.55rem;
  border: 1px solid var(--graphite);
  background: var(--paper);
  transform: rotate(45deg);
}

.callout-driver {
  top: 18%;
  left: 7%;
  padding-right: 4rem;
  text-align: right;
}

.callout-driver::before {
  right: 0;
}

.callout-driver .pin {
  right: -0.2rem;
}

.callout-frame {
  top: 13%;
  right: 7%;
  padding-left: 4rem;
}

.callout-frame::before {
  left: 0;
}

.callout-frame .pin {
  left: -0.2rem;
}

.callout-pads {
  bottom: 19%;
  left: 7%;
  padding-right: 4rem;
  text-align: right;
}

.callout-pads::before {
  right: 0;
}

.callout-pads .pin {
  right: -0.2rem;
}

.callout-path {
  bottom: 14%;
  right: 7%;
  padding-left: 4rem;
}

.callout-path::before {
  left: 0;
}

.callout-path .pin {
  left: -0.2rem;
}

.model-copy {
  max-width: 44rem;
  margin: 1rem 0 0;
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.78rem;
}

.section-heading {
  display: grid;
  grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
  gap: 1.5rem;
  align-items: end;
  margin-bottom: clamp(1.8rem, 4vw, 3.2rem);
  border-top: 1px solid var(--rule);
  padding-top: clamp(1.2rem, 3vw, 2rem);
}

.measurement-panel {
  border-block: 1px solid var(--rule);
  padding-block: clamp(1.5rem, 3vw, 2.4rem);
}

.signal-graph {
  width: 100%;
  height: auto;
  margin-bottom: clamp(1.5rem, 4vw, 3rem);
}

.grid-lines path {
  fill: none;
  stroke: rgba(23, 23, 23, 0.12);
  stroke-width: 1;
}

.trace-line {
  fill: none;
  stroke: url(#trace);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-dasharray: 940;
  stroke-dashoffset: 940;
  animation: trace-draw 1.4s ease forwards 0.25s;
}

.listening-grid,
.material-grid,
.family-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
  gap: 1px;
  background: var(--rule);
  border: 1px solid var(--rule);
}

.listening-grid article,
.material-card,
.product-card {
  min-width: 0;
  background: rgba(251, 248, 240, 0.58);
  padding: clamp(1.1rem, 2.3vw, 1.7rem);
  transition: transform 180ms ease, background 180ms ease;
}

.listening-grid article:hover,
.material-card:hover,
.product-card:hover {
  transform: translateY(-3px);
  background: rgba(251, 248, 240, 0.86);
}

.listening-grid p,
.material-card p,
.product-card p,
.audition-copy p,
.site-footer p {
  color: var(--muted);
}

.material-card {
  position: relative;
  min-height: 17rem;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.material-swatch {
  position: absolute;
  inset: 1rem 1rem auto 1rem;
  height: 7rem;
  border: 1px solid rgba(23, 23, 23, 0.1);
  background-size: cover;
  background-position: center;
}

.aluminum .material-swatch {
  background:
    linear-gradient(90deg, rgba(251, 248, 240, 0.08), rgba(23, 23, 23, 0.18)),
    url("../assets/amplifier-input-knobs.jpg") center / cover;
}

.damping .material-swatch {
  background:
    linear-gradient(90deg, rgba(23, 23, 23, 0.18), rgba(23, 23, 23, 0.02)),
    url("../assets/black-leather-texture.jpg") center / cover;
}

.service .material-swatch {
  background:
    linear-gradient(90deg, rgba(251, 248, 240, 0.1), rgba(23, 23, 23, 0.22)),
    url("../assets/headphones-leather-closeup.jpg") center / cover;
}

.compact-heading h2 {
  max-width: 16ch;
}

.product-card {
  min-height: 22rem;
}

.product-mark {
  width: 100%;
  aspect-ratio: 16 / 9;
  margin-bottom: 1.4rem;
  border: 1px solid rgba(23, 23, 23, 0.1);
  background:
    linear-gradient(180deg, rgba(251, 248, 240, 0.04), rgba(23, 23, 23, 0.24)),
    url("../assets/headphones-leather-closeup.jpg") center / cover;
}

.product-mark.amp {
  background:
    linear-gradient(180deg, rgba(251, 248, 240, 0.04), rgba(23, 23, 23, 0.2)),
    url("../assets/tube-amplifier-front.jpg") center / cover;
}

.product-mark.dac {
  background:
    linear-gradient(180deg, rgba(251, 248, 240, 0.06), rgba(23, 23, 23, 0.26)),
    url("../assets/audio-control-panel.jpg") center / cover;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
  margin-top: 1.2rem;
}

.tags span {
  border: 1px solid rgba(23, 23, 23, 0.16);
  padding: 0.32rem 0.5rem;
  color: #514b44;
  font-family: var(--mono);
  font-size: 0.68rem;
  text-transform: uppercase;
}

.audition {
  display: grid;
  grid-template-columns: minmax(0, 0.76fr) minmax(0, 1fr);
  gap: clamp(2rem, 5vw, 4rem);
  align-items: start;
  border-top: 1px solid var(--rule);
}

.audition-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  background: var(--rule);
  border: 1px solid var(--rule);
}

.audition-form label,
.audition-form button {
  min-width: 0;
}

.audition-form label {
  display: grid;
  gap: 0.55rem;
  background: rgba(251, 248, 240, 0.72);
  padding: 1rem;
}

.audition-form span {
  color: var(--muted);
  font-family: var(--mono);
  font-size: 0.72rem;
  text-transform: uppercase;
}

.audition-form input,
.audition-form select {
  width: 100%;
  min-height: 2.8rem;
  border: 1px solid rgba(23, 23, 23, 0.22);
  background: rgba(255, 253, 247, 0.62);
  color: var(--graphite);
  padding: 0.65rem 0.75rem;
}

.audition-form button {
  grid-column: 1 / -1;
  border-color: var(--graphite);
}

.site-footer {
  width: min(1180px, calc(100% - 2rem));
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  border-top: 1px solid var(--rule);
  padding-block: 1.4rem 2rem;
  font-family: var(--mono);
  font-size: 0.74rem;
}

.site-footer p {
  margin: 0;
}

.site-footer p:first-child {
  color: var(--graphite);
  font-weight: 500;
  letter-spacing: 0.22em;
}

@keyframes trace-draw {
  to {
    stroke-dashoffset: 0;
  }
}

@media (max-width: 58rem) {
  .hero,
  .audition,
  .section-heading {
    grid-template-columns: 1fr;
  }

  h1 {
    max-width: 10ch;
  }

  .product-stage {
    max-height: none;
  }

  .section-heading {
    align-items: start;
  }
}

@media (max-width: 42rem) {
  .nav-shell {
    min-height: auto;
    align-items: flex-start;
    flex-direction: column;
    padding-block: 1rem;
  }

  .nav-links {
    justify-content: flex-start;
  }

  .hero {
    min-height: auto;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .button {
    width: 100%;
  }

  .hero-notes,
  .audition-form {
    grid-template-columns: 1fr;
  }

  .callout {
    width: 42%;
  }

  .callout::before {
    width: 2.2rem;
  }

  .callout-driver,
  .callout-pads {
    padding-right: 2.7rem;
  }

  .callout-frame,
  .callout-path {
    padding-left: 2.7rem;
  }

  .site-footer {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 1ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 1ms !important;
  }
}
