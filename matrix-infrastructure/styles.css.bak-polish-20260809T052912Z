/* =========================================================
   MATRIX — Adaptive Infrastructure Intelligence
   Black-site infrastructure palette · topology-native layout
   ========================================================= */

:root {
  /* palette */
  --black:   #020503;
  --deep:    #06130C;
  --glass:   #143524;
  --matrix:  #00FF7A;
  --lime:    #B7FF3C;
  --cyan:    #38F2D7;
  --phos:    #8CA997;
  --amber:   #F6B743;

  --glass-1: rgba(20, 53, 36, 0.34);
  --glass-2: rgba(9, 30, 19, 0.62);
  --glass-brd: rgba(0, 255, 122, 0.16);
  --glass-brd-hot: rgba(0, 255, 122, 0.42);
  --hair: rgba(140, 169, 151, 0.14);

  --ink:     #DFF6E8;
  --ink-dim: #9FBCAB;
  --ink-mut: #6C8677;

  /* type */
  --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-disp: 'Space Grotesk', 'Inter', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', 'SFMono-Regular', ui-monospace, Menlo, monospace;

  /* scale */
  --step--1: clamp(0.78rem, 0.74rem + 0.2vw, 0.86rem);
  --step-0:  clamp(0.98rem, 0.94rem + 0.2vw, 1.06rem);
  --step-1:  clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem);
  --step-2:  clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem);
  --step-3:  clamp(2.3rem, 1.7rem + 2.9vw, 4rem);
  --step-4:  clamp(3rem, 2rem + 4.6vw, 5.6rem);

  --maxw: 1240px;
  --pad: clamp(1.1rem, 4vw, 3rem);
  --r: 14px;
  --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--black);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: var(--step-0);
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

/* ambient field */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -2;
  background:
    radial-gradient(120% 80% at 78% -10%, rgba(0,255,122,0.10), transparent 55%),
    radial-gradient(90% 70% at 10% 110%, rgba(56,242,215,0.07), transparent 60%),
    linear-gradient(180deg, #020503 0%, #030b07 45%, #020503 100%);
}
body::after {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.5;
  background-image:
    linear-gradient(rgba(0,255,122,0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,255,122,0.035) 1px, transparent 1px);
  background-size: 46px 46px;
  mask-image: radial-gradient(120% 100% at 50% 0%, #000 30%, transparent 90%);
}

img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

.visually-hidden, .skip-link:not(:focus) {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}
.skip-link {
  position: fixed; top: 12px; left: 12px; z-index: 100;
  background: var(--matrix); color: #021; padding: 0.5rem 0.9rem; border-radius: 8px;
  font-family: var(--font-mono); font-size: var(--step--1);
}

:focus-visible {
  outline: 2px solid var(--matrix);
  outline-offset: 3px;
  border-radius: 4px;
}

/* ---------- shared type ---------- */
.eyebrow {
  font-family: var(--font-mono);
  font-size: var(--step--1);
  letter-spacing: 0.16em;
  color: var(--ink-dim);
  text-transform: lowercase;
  display: flex; align-items: center; gap: 0.6rem;
  margin: 0 0 1.1rem;
}
.eyebrow__tag {
  color: var(--matrix);
  border: 1px solid var(--glass-brd);
  background: rgba(0,255,122,0.06);
  padding: 0.15rem 0.5rem; border-radius: 5px;
  letter-spacing: 0.14em;
}
.section-title {
  font-family: var(--font-disp);
  font-weight: 600;
  font-size: var(--step-3);
  line-height: 1.02;
  letter-spacing: -0.02em;
  margin: 0 0 1rem;
  text-wrap: balance;
}
.section-title .dim { color: var(--ink-mut); }
.section-lede {
  color: var(--ink-dim);
  font-size: var(--step-1);
  line-height: 1.5;
  max-width: 56ch;
  margin: 0;
}
.glow {
  color: var(--matrix);
  text-shadow: 0 0 24px rgba(0,255,122,0.45), 0 0 4px rgba(183,255,60,0.6);
}

/* ---------- buttons / command nodes ---------- */
.btn {
  --bg: transparent;
  font-family: var(--font-mono);
  font-size: var(--step--1);
  letter-spacing: 0.06em;
  display: inline-flex; align-items: center; gap: 0.4rem;
  padding: 0.72rem 1.15rem;
  border-radius: 10px;
  border: 1px solid var(--glass-brd);
  background: var(--bg);
  color: var(--ink);
  transition: transform .25s var(--ease), border-color .25s var(--ease),
              box-shadow .25s var(--ease), background .25s var(--ease), color .2s;
  cursor: pointer;
  white-space: nowrap;
}
.btn__brk { color: var(--matrix); opacity: 0.8; }
.btn--node {
  background: linear-gradient(180deg, rgba(0,255,122,0.16), rgba(0,255,122,0.05));
  border-color: var(--glass-brd-hot);
  color: var(--ink);
  box-shadow: 0 0 0 1px rgba(0,255,122,0.08), 0 10px 30px -14px rgba(0,255,122,0.6);
}
.btn--node:hover { transform: translateY(-2px); box-shadow: 0 14px 40px -12px rgba(0,255,122,0.7); border-color: var(--matrix); }
.btn--ghost:hover, .btn--wire:hover { border-color: var(--glass-brd-hot); background: rgba(0,255,122,0.06); transform: translateY(-2px); }
.btn--wire { padding: 0.5rem 0.85rem; }
.btn--exec { margin-top: 0.2rem; }

/* ================= TOP READOUT NAV ================= */
.topbar {
  position: sticky; top: 0; z-index: 40;
  backdrop-filter: blur(12px);
  background: linear-gradient(180deg, rgba(2,5,3,0.86), rgba(2,5,3,0.4));
  border-bottom: 1px solid var(--hair);
}
.topbar__inner {
  max-width: var(--maxw); margin: 0 auto;
  padding: 0.7rem var(--pad);
  display: flex; align-items: center; gap: 1.2rem;
}
.wordmark { display: flex; align-items: center; gap: 0.55rem; }
.wordmark__glyph { display: grid; place-items: center; }
.wordmark__type {
  font-family: var(--font-disp); font-weight: 700; font-size: 1.12rem;
  letter-spacing: 0.28em; padding-left: 0.1em;
}
.readouts { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
.readout {
  font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.1;
  display: flex; flex-direction: column; gap: 1px;
  padding: 0.28rem 0.7rem; border-radius: 7px;
  border: 1px solid transparent;
  transition: border-color .2s, background .2s;
}
.readout__k { color: var(--ink-mut); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.6rem; }
.readout__v { color: var(--ink-dim); letter-spacing: 0.02em; }
a.readout:hover { border-color: var(--glass-brd); background: rgba(0,255,122,0.05); }
.readout--live .readout__v { color: var(--matrix); display: flex; align-items: center; gap: 0.35rem; }
.dot {
  width: 6px; height: 6px; border-radius: 50%; background: var(--matrix);
  box-shadow: 0 0 8px var(--matrix); display: inline-block;
  animation: pulseDot 2.4s var(--ease) infinite;
}
@keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.4;transform:scale(0.7)} }

/* ================= HERO ================= */
.hero {
  max-width: var(--maxw); margin: 0 auto;
  padding: clamp(2rem, 5vw, 4.5rem) var(--pad) clamp(2.5rem, 5vw, 4rem);
}
.hero__grid {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  gap: clamp(1.5rem, 4vw, 3.2rem);
  align-items: center;
}
.hero__intro { min-width: 0; }
.hero__title {
  font-family: var(--font-disp);
  font-weight: 700;
  font-size: var(--step-4);
  line-height: 0.98;
  letter-spacing: -0.03em;
  margin: 0 0 1.2rem;
  text-wrap: balance;
}
.hero__lede {
  color: var(--ink-dim);
  font-size: var(--step-1);
  line-height: 1.5;
  max-width: 46ch;
  margin: 0 0 1.8rem;
}
.hero__cta { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-bottom: 2rem; }
.hero__coverage {
  display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
  margin: 0; padding-top: 1.3rem;
  border-top: 1px solid var(--hair);
  font-family: var(--font-mono);
}
.hero__coverage div { display: flex; flex-direction: column; gap: 2px; }
.hero__coverage dt { font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mut); }
.hero__coverage dd { margin: 0; font-size: var(--step--1); color: var(--ink-dim); }
.live-tag, .pread__v--live {
  color: var(--matrix);
  position: relative; padding-left: 0.9rem;
}
.live-tag::before, .pread__v--live::before {
  content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 6px; height: 6px; border-radius: 50%; background: var(--matrix);
  box-shadow: 0 0 8px var(--matrix); animation: pulseDot 1.8s infinite;
}

/* ----- THE LATTICE (bold screenshot moment) ----- */
.lattice { margin: 0; min-width: 0; }
.lattice__frame {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 0.66;
  max-height: min(78vh, 620px);
  border-radius: 18px;
  overflow: hidden;
  border: 1px solid var(--glass-brd);
  background: radial-gradient(120% 120% at 50% 40%, #06170e 0%, #020503 70%);
  box-shadow:
    0 0 0 1px rgba(0,255,122,0.06),
    0 40px 90px -40px rgba(0,255,122,0.35),
    inset 0 0 120px rgba(0,0,0,0.7);
  isolation: isolate;
}
.lattice__substrate {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.16;
  filter: grayscale(0.3) contrast(1.1) brightness(0.6) saturate(0.7) hue-rotate(80deg);
  mask-image: radial-gradient(90% 90% at 50% 50%, #000 20%, transparent 85%);
  z-index: 0;
}
.lattice__scan {
  position: absolute; inset: 0; z-index: 3; pointer-events: none;
  background: linear-gradient(180deg, transparent 0%, rgba(0,255,122,0.06) 50%, transparent 100%);
  background-size: 100% 220%;
  animation: scanMove 7s linear infinite;
  mix-blend-mode: screen;
  opacity: 0.7;
}
@keyframes scanMove { 0%{background-position:0 -60%} 100%{background-position:0 160%} }
.lattice__svg { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; }

.route { stroke-dasharray: var(--len, 600); stroke-dashoffset: var(--len, 600); opacity: 0.9; }
.route--ring { opacity: 0.4; stroke-width: 1; }
.routes.drawn .route { animation: draw 2.2s var(--ease) forwards; animation-delay: var(--d, 0s); }
@keyframes draw { to { stroke-dashoffset: 0; } }

.node__label {
  font-size: 12px; fill: var(--ink); letter-spacing: 0.14em;
  font-weight: 500; paint-order: stroke; stroke: #020503; stroke-width: 3px;
}
.node__label--core { font-size: 14px; fill: var(--lime); letter-spacing: 0.18em; }
.node__sub { font-size: 9px; fill: var(--ink-mut); letter-spacing: 0.1em; }
.node__dot { filter: drop-shadow(0 0 6px currentColor); }
.node__glow { fill: rgba(0,255,122,0.12); }
.node__halo { fill: url(#coreGlow); }
.node__ring { transform-origin: center; animation: coreSpin 22s linear infinite; }
@keyframes coreSpin { to { transform: rotate(360deg); } }
.node--core .node__dot { animation: corePulse 3.4s var(--ease) infinite; }
@keyframes corePulse { 0%,100%{r:9;opacity:1} 50%{r:12;opacity:0.75} }
.node { transition: transform .3s var(--ease); }
.node:hover .node__glow { fill: rgba(0,255,122,0.28); }

.pulse-dot { filter: drop-shadow(0 0 5px var(--lime)); }

.lattice__annot {
  position: absolute; z-index: 4;
  font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em;
  color: var(--ink-dim); text-transform: uppercase;
  padding: 0.24rem 0.5rem; border: 1px solid var(--hair); border-radius: 5px;
  background: rgba(2,5,3,0.55); backdrop-filter: blur(4px);
}
.lattice__annot--tl { top: 12px; left: 12px; }
.lattice__annot--br { bottom: 12px; right: 12px; color: var(--matrix); border-color: var(--glass-brd); }
.lattice__coreread {
  position: absolute; bottom: 12px; left: 12px; z-index: 4;
  display: grid; grid-template-columns: auto auto; gap: 1px 0.8rem;
  font-family: var(--font-mono); font-size: 0.62rem;
  padding: 0.4rem 0.6rem; border-radius: 7px;
  background: rgba(2,5,3,0.6); border: 1px solid var(--hair); backdrop-filter: blur(4px);
}
.lattice__coreread .k { color: var(--ink-mut); letter-spacing: 0.1em; text-transform: uppercase; }
.lattice__coreread .v { color: var(--lime); text-align: right; }

/* ================= CAPABILITY FIELD ================= */
.field {
  position: relative;
  max-width: var(--maxw); margin: 0 auto;
  padding: clamp(3rem, 7vw, 6rem) var(--pad);
  overflow: hidden;
}
.field__strip {
  position: absolute; z-index: 0;
  top: 8%; right: -8%; width: 60%; height: 84%;
  object-fit: cover;
  opacity: 0.12;
  filter: grayscale(0.4) contrast(1.15) brightness(0.55) hue-rotate(80deg) saturate(0.8);
  clip-path: polygon(22% 0, 100% 6%, 100% 100%, 0 82%);
  mask-image: linear-gradient(120deg, transparent 0%, #000 40%, #000 70%, transparent 100%);
  pointer-events: none;
}
.field__head { position: relative; z-index: 2; max-width: 62ch; margin-bottom: clamp(2rem, 4vw, 3.5rem); }
.field__stage {
  position: relative; z-index: 2;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  grid-auto-rows: minmax(10px, auto);
  gap: 1.1rem;
}
.field__rails { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.5; }
.frail { stroke-dasharray: 5 7; opacity: 0.5; animation: railFlow 6s linear infinite; }
@keyframes railFlow { to { stroke-dashoffset: -120; } }

/* glass shards — asymmetric, clipped, never a uniform card grid */
.shard {
  position: relative; z-index: 2;
  padding: 1.5rem 1.5rem 1.3rem;
  background: linear-gradient(155deg, var(--glass-1), var(--glass-2));
  border: 1px solid var(--glass-brd);
  backdrop-filter: blur(8px);
  clip-path: polygon(0 0, 100% 0, 100% 86%, 92% 100%, 0 100%);
  transition: transform .35s var(--ease), border-color .35s var(--ease), box-shadow .35s var(--ease);
  opacity: 0; transform: translateY(26px);
}
.shard.in { opacity: 1; transform: none; transition-delay: calc(var(--i) * 70ms); }
.shard::before {
  content: ""; position: absolute; left: 0; top: 1.5rem; width: 3px; height: 2.2rem;
  background: linear-gradient(var(--matrix), var(--cyan)); border-radius: 2px;
  box-shadow: 0 0 12px rgba(0,255,122,0.6);
}
.shard:hover { transform: translateY(-4px); border-color: var(--glass-brd-hot); box-shadow: 0 24px 60px -30px rgba(0,255,122,0.5); }
.shard__idx {
  font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.2em;
  color: var(--matrix); text-transform: uppercase; display: block; margin-bottom: 0.7rem; padding-left: 0.9rem;
}
.shard__title { font-family: var(--font-disp); font-weight: 600; font-size: var(--step-1); line-height: 1.12; margin: 0 0 0.6rem; padding-left: 0.9rem; letter-spacing: -0.01em; }
.shard__body { color: var(--ink-dim); font-size: var(--step--1); line-height: 1.55; margin: 0 0 1rem; padding-left: 0.9rem; }
.shard__route { font-family: var(--font-mono); font-size: 0.62rem; color: var(--ink-mut); letter-spacing: 0.08em; padding-left: 0.9rem; }

/* deliberate asymmetric spans + offsets */
.shard--a { grid-column: 1 / span 5; }
.shard--b { grid-column: 6 / span 4; margin-top: 2.6rem; clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%, 0 14%); }
.shard--c { grid-column: 10 / span 3; }
.shard--d { grid-column: 1 / span 4; margin-top: -0.5rem; }
.shard--e { grid-column: 5 / span 5; clip-path: polygon(0 0, 100% 0, 100% 100%, 6% 100%, 0 88%); }
.shard--f { grid-column: 10 / span 3; margin-top: 2.2rem; }

/* proof pinned to a signal path */
.proofpath { position: relative; z-index: 2; margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: 2rem; }
.proofpath__line { position: absolute; top: 0; left: 0; width: 100%; height: 70px; z-index: 0; opacity: 0.55; }
.pline { stroke-dasharray: 6 8; animation: railFlow 8s linear infinite reverse; }
.proofpath__reads {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-wrap: wrap; gap: 0.7rem 0.9rem;
  position: relative; z-index: 1;
}
.pread {
  font-family: var(--font-mono); font-size: 0.68rem;
  display: flex; align-items: center; gap: 0.5rem;
  padding: 0.45rem 0.75rem; border-radius: 8px;
  background: rgba(2,5,3,0.6); border: 1px solid var(--hair);
  backdrop-filter: blur(4px);
  opacity: 0; transform: translateY(14px);
}
.pread.in { opacity: 1; transform: none; transition: all .5s var(--ease); transition-delay: calc(var(--p) * 60ms); }
.pread__k { color: var(--ink-mut); text-transform: uppercase; letter-spacing: 0.1em; }
.pread__v { color: var(--ink); }
.pread__v--amber { color: var(--amber); }

/* ================= OPERATING MODEL ================= */
.model {
  max-width: var(--maxw); margin: 0 auto;
  padding: clamp(3rem, 7vw, 6rem) var(--pad);
}
.model__head { max-width: 64ch; margin-bottom: clamp(2rem, 4vw, 3rem); }
.flow {
  position: relative;
  border: 1px solid var(--glass-brd);
  border-radius: 18px;
  padding: clamp(1.4rem, 3vw, 2.6rem);
  background: linear-gradient(160deg, rgba(6,19,12,0.75), rgba(2,5,3,0.9));
  overflow: hidden;
  isolation: isolate;
}
.flow__screen {
  position: absolute; z-index: 0;
  inset: 0; width: 100%; height: 100%;
  object-fit: cover; opacity: 0.09;
  filter: grayscale(0.5) brightness(0.6) hue-rotate(85deg) saturate(0.7);
  mask-image: linear-gradient(90deg, transparent, #000 30%, #000 60%, transparent);
}
.flow__bands {
  position: relative; z-index: 2;
  display: flex; flex-wrap: wrap; align-items: stretch;
  gap: 0.5rem;
}
.band {
  position: relative;
  flex: 1 1 130px;
  min-width: 130px;
  padding: 1rem 1rem 1.1rem;
  border: 1px solid var(--glass-brd);
  background: linear-gradient(180deg, rgba(20,53,36,0.4), rgba(9,30,19,0.5));
  backdrop-filter: blur(6px);
  clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
  margin-right: -14px;
  opacity: 0; transform: translateX(-16px);
}
.band:last-child { margin-right: 0; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
.band.in { opacity: 1; transform: none; transition: all .55s var(--ease); transition-delay: calc(var(--b) * 90ms); }
.band__label {
  font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em;
  text-transform: uppercase; color: var(--matrix); display: block; margin-bottom: 0.55rem;
}
.band__note { font-size: 0.74rem; color: var(--ink-dim); margin: 0; line-height: 1.4; }
.band__chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; }
.band__chips li {
  font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.04em;
  padding: 0.18rem 0.42rem; border-radius: 5px;
  border: 1px solid var(--hair); color: var(--ink-dim);
  background: rgba(2,5,3,0.4);
}
.band__chips--out li { border-color: var(--glass-brd); color: var(--lime); }
.band--graph, .band--gov, .band--ctrl { background: linear-gradient(180deg, rgba(20,53,36,0.55), rgba(9,30,19,0.6)); }
.band--auto { background: linear-gradient(180deg, rgba(246,183,67,0.08), rgba(9,30,19,0.6)); }
.band--auto .band__label { color: var(--amber); }
.band--out { background: linear-gradient(180deg, rgba(0,255,122,0.1), rgba(9,30,19,0.6)); flex: 1.3 1 180px; }
.flow__connectors { position: relative; z-index: 1; width: 100%; height: 30px; margin-top: 0.6rem; opacity: 0.6; }

/* ================= SECURITY / WHEEL ================= */
.security {
  position: relative;
  padding: clamp(3rem, 7vw, 6rem) 0;
  background:
    radial-gradient(80% 100% at 80% 50%, rgba(0,255,122,0.06), transparent 60%),
    linear-gradient(180deg, transparent, rgba(3,10,6,0.6), transparent);
  border-top: 1px solid var(--hair);
  border-bottom: 1px solid var(--hair);
}
.security__inner {
  max-width: var(--maxw); margin: 0 auto; padding: 0 var(--pad);
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
  gap: clamp(2rem, 5vw, 4rem); align-items: center;
}
.security__legend { list-style: none; margin: 1.8rem 0 0; padding: 0; display: grid; gap: 0.55rem; }
.security__legend li {
  font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-dim);
  display: flex; align-items: center; gap: 0.6rem;
  padding: 0.45rem 0.7rem; border-radius: 8px; border: 1px solid transparent;
  transition: border-color .25s, background .25s, color .25s;
  cursor: default;
}
.security__legend .lg-dot {
  width: 9px; height: 9px; border-radius: 2px; flex: none;
  background: var(--matrix); box-shadow: 0 0 8px var(--matrix);
  transition: transform .25s;
}
.security__legend li[data-fn="govern"] .lg-dot { background: var(--lime); box-shadow: 0 0 8px var(--lime); }
.security__legend li[data-fn="detect"] .lg-dot { background: var(--cyan); box-shadow: 0 0 8px var(--cyan); }
.security__legend li[data-fn="respond"] .lg-dot { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
.security__legend li.active, .security__legend li:hover {
  border-color: var(--glass-brd-hot); background: rgba(0,255,122,0.06); color: var(--ink);
}
.security__legend li.active .lg-dot { transform: scale(1.35); }

.wheel { margin: 0; }
.wheel__frame {
  position: relative;
  width: 100%; max-width: 460px; margin-inline: auto;
  aspect-ratio: 1 / 1;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid var(--glass-brd);
  background: radial-gradient(circle at 50% 45%, #06170e, #020503 72%);
  box-shadow: inset 0 0 80px rgba(0,0,0,0.7), 0 30px 70px -40px rgba(0,255,122,0.4);
  display: grid; place-items: center;
}
.wheel__svg { width: 100%; height: 100%; }
.wheel__seg path { transition: stroke-width .3s var(--ease), opacity .3s; cursor: pointer; }
.wheel__seg path.active { stroke-width: 32; opacity: 1 !important; }
.wheel__hubk { font-family: var(--font-mono); font-size: 13px; fill: var(--ink-mut); letter-spacing: 0.24em; }
.wheel__hubv { font-family: var(--font-disp); font-size: 15px; font-weight: 600; fill: var(--lime); letter-spacing: 0.14em; }
.wheel__seglabel { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; fill: var(--ink); paint-order: stroke; stroke: #020503; stroke-width: 3px; }
.wheel__annot {
  position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
  font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em;
  color: var(--ink-dim); text-transform: uppercase; white-space: nowrap;
  padding: 0.24rem 0.6rem; border: 1px solid var(--hair); border-radius: 5px;
  background: rgba(2,5,3,0.6); backdrop-filter: blur(4px);
}

/* ================= ACCESS TERMINAL ================= */
.access {
  max-width: var(--maxw); margin: 0 auto;
  padding: clamp(3rem, 7vw, 6.5rem) var(--pad) clamp(3rem, 6vw, 5rem);
}
.access__inner {
  display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: clamp(2rem, 5vw, 3.5rem); align-items: center;
}
.access__lead { max-width: 44ch; }
.terminal {
  border: 1px solid var(--glass-brd);
  border-radius: 14px;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(6,19,12,0.9), rgba(2,5,3,0.96));
  box-shadow: 0 40px 90px -50px rgba(0,255,122,0.5), inset 0 0 0 1px rgba(0,255,122,0.05);
}
.terminal__bar {
  display: flex; align-items: center; gap: 0.4rem;
  padding: 0.65rem 0.9rem;
  background: rgba(0,255,122,0.05);
  border-bottom: 1px solid var(--hair);
  font-family: var(--font-mono); font-size: 0.72rem;
}
.terminal__dot { width: 9px; height: 9px; border-radius: 50%; background: var(--glass); border: 1px solid var(--glass-brd); }
.terminal__dot:nth-child(1) { background: rgba(246,183,67,0.5); }
.terminal__dot:nth-child(2) { background: rgba(56,242,215,0.4); }
.terminal__dot:nth-child(3) { background: rgba(0,255,122,0.5); }
.terminal__path { margin-left: 0.6rem; color: var(--ink-dim); letter-spacing: 0.08em; }
.terminal__body { padding: 1.3rem clamp(1rem, 3vw, 1.8rem) 1.6rem; }
.terminal__log { margin: 0 0 1.3rem; font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.9; }
.terminal__log code { color: var(--ink-dim); }
.tl { display: block; }
.pr { color: var(--matrix); }
.tl--type .typed { color: var(--lime); }
.caret {
  display: inline-block; width: 8px; height: 1em; vertical-align: text-bottom;
  background: var(--matrix); margin-left: 2px;
  animation: blink 1.1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.terminal__form { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
.tfield { display: flex; flex-direction: column; gap: 0.35rem; }
.tfield--wide { grid-column: 1 / -1; }
.tfield label { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mut); }
.tfield input {
  font-family: var(--font-mono); font-size: 0.84rem;
  padding: 0.7rem 0.85rem; border-radius: 9px;
  background: rgba(2,5,3,0.7); color: var(--ink);
  border: 1px solid var(--glass-brd);
  transition: border-color .2s, box-shadow .2s;
}
.tfield input::placeholder { color: var(--ink-mut); }
.tfield input:focus { outline: none; border-color: var(--matrix); box-shadow: 0 0 0 3px rgba(0,255,122,0.14); }
.terminal__form .btn--exec { grid-column: 1 / -1; justify-self: start; }
.terminal__status { grid-column: 1 / -1; margin: 0; font-family: var(--font-mono); font-size: 0.72rem; color: var(--matrix); min-height: 1em; }
.terminal__status.err { color: var(--amber); }

/* ================= FOOTER ================= */
.foot { border-top: 1px solid var(--hair); padding: clamp(2rem, 4vw, 3rem) var(--pad); }
.foot__inner { max-width: var(--maxw); margin: 0 auto; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.5rem; }
.foot__mark { font-family: var(--font-disp); font-weight: 700; letter-spacing: 0.28em; font-size: 1.1rem; }
.foot__line { color: var(--ink-dim); margin: 0; font-size: var(--step--1); flex: 1 1 260px; }
.foot__meta { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-mut); margin: 0; display: flex; align-items: center; gap: 0.5rem; width: 100%; }
.foot__stat { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--ink-dim); }

/* ================= RESPONSIVE ================= */
@media (max-width: 940px) {
  .hero__grid { grid-template-columns: 1fr; }
  .lattice { order: -1; }
  .security__inner { grid-template-columns: 1fr; }
  .access__inner { grid-template-columns: 1fr; }
  .field__stage { grid-template-columns: repeat(6, 1fr); }
  .shard--a { grid-column: 1 / span 6; }
  .shard--b { grid-column: 1 / span 6; margin-top: 0; }
  .shard--c { grid-column: 1 / span 6; }
  .shard--d { grid-column: 1 / span 6; margin-top: 0; }
  .shard--e { grid-column: 1 / span 6; }
  .shard--f { grid-column: 1 / span 6; margin-top: 0; }
}
@media (max-width: 620px) {
  .readouts { display: none; }
  .topbar .btn--wire { margin-left: auto; }
  .field__stage { grid-template-columns: 1fr; }
  .shard, .shard--a, .shard--b, .shard--c, .shard--d, .shard--e, .shard--f { grid-column: 1 / -1; }
  .terminal__form { grid-template-columns: 1fr; }
  .flow__bands { flex-direction: column; }
  .band { margin-right: 0; margin-bottom: -12px; clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%); }
  .band:last-child { margin-bottom: 0; clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
  .hero__coverage { gap: 0.8rem 1.2rem; }
}

/* ================= REDUCED MOTION — same footprint, fully visible ================= */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  .route { stroke-dashoffset: 0 !important; }
  .routes .route { animation: none !important; }
  .shard, .pread, .band { opacity: 1 !important; transform: none !important; }
  .lattice__scan, .frail, .pline { animation: none !important; }
  .caret { animation: none !important; opacity: 1; }
  .node__ring, .node--core .node__dot { animation: none !important; }
}
