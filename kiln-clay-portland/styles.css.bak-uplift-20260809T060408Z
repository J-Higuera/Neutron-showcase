:root {
  --kiln-ember: #D86B2A;
  --reduction-brown: #3A2118;
  --wet-clay: #9B6F55;
  --bisque: #E7D7C3;
  --rain: #7F9186;
  --moss: #5E735F;
  --charcoal: #171311;
  --paper: #f4ebde;
  --bone: #fff8ed;
  --ink-soft: var(--reduction-brown);
  --line: rgba(58, 33, 24, .18);
  --glow: rgba(216, 107, 42, .38);
  --shadow: 0 22px 70px rgba(23, 19, 17, .22), 0 7px 22px rgba(58, 33, 24, .13);
  --max: 1180px;
  --gutter: clamp(1rem, 4vw, 3rem);
  --section: clamp(4.5rem, 9vw, 8rem);
  --r-sm: .35rem;
  --r-md: .8rem;
  --r-lg: 1.4rem;
  --serif: "Fraunces", Georgia, serif;
  --sans: "Work Sans", system-ui, sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, monospace;
  --ease: cubic-bezier(.16, 1, .3, 1);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  background: var(--charcoal);
  color: var(--charcoal);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--sans);
  font-size: clamp(1rem, .96rem + .18vi, 1.12rem);
  line-height: 1.6;
  background:
    radial-gradient(circle at 8% 18%, rgba(127, 145, 134, .22), transparent 26rem),
    radial-gradient(circle at 92% 6%, rgba(216, 107, 42, .2), transparent 24rem),
    linear-gradient(115deg, rgba(255, 255, 255, .26), transparent 32%),
    var(--paper);
  overflow-x: hidden;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .44;
  z-index: 20;
  background-image:
    repeating-linear-gradient(90deg, rgba(23, 19, 17, .025) 0 1px, transparent 1px 5px),
    radial-gradient(circle at 24% 18%, rgba(58, 33, 24, .09) 0 1px, transparent 1.4px),
    radial-gradient(circle at 72% 62%, rgba(94, 115, 95, .08) 0 1px, transparent 1.2px);
  background-size: auto, 31px 29px, 23px 27px;
  mix-blend-mode: multiply;
}

img,
svg {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

:focus-visible {
  outline: 3px solid color-mix(in srgb, var(--kiln-ember), white 20%);
  outline-offset: 4px;
}

.skip-link {
  position: fixed;
  left: 1rem;
  top: 1rem;
  z-index: 100;
  transform: translateY(-140%);
  background: var(--bone);
  padding: .65rem .9rem;
  border-radius: 999px;
}

.skip-link:focus {
  transform: translateY(0);
}

.site-header {
  position: fixed;
  top: .85rem;
  left: 50%;
  z-index: 15;
  transform: translateX(-50%);
  width: min(calc(100% - 1.5rem), var(--max));
  min-height: 3.4rem;
  display: flex;
  align-items: center;
  gap: .75rem;
  padding: .48rem .55rem .48rem .7rem;
  color: var(--bone);
  background: rgba(23, 19, 17, .92);
  border: 1px solid rgba(231, 215, 195, .34);
  border-radius: 999px;
  box-shadow: 0 12px 42px rgba(23, 19, 17, .28);
  backdrop-filter: blur(12px);
}

.brand,
.top-nav,
.hero-actions,
.shop-actions,
.notice-actions,
.hero-footnote {
  display: flex;
  align-items: center;
}

.brand {
  gap: .55rem;
  text-decoration: none;
  font-family: var(--serif);
  font-weight: 760;
  white-space: nowrap;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 2.25rem;
  aspect-ratio: 1;
  border-radius: 48% 42% 45% 50% / 46% 54% 41% 50%;
  background: var(--reduction-brown);
  color: var(--bone);
  box-shadow: inset 0 0 0 2px var(--kiln-ember);
  font: 800 .74rem/1 var(--mono);
}

.top-nav {
  gap: .15rem;
  margin-inline: auto;
}

.top-nav a,
.header-cta {
  min-height: 2.3rem;
  display: grid;
  place-items: center;
  padding-inline: .85rem;
  border-radius: 999px;
  text-decoration: none;
  font: 760 .78rem/1 var(--sans);
}

.top-nav a {
  color: var(--bone);
}

.top-nav a:hover {
  background: rgba(255, 248, 237, .1);
  color: var(--bone);
}

.header-cta {
  background: var(--bone);
  color: var(--reduction-brown);
  box-shadow: inset 0 0 0 1px rgba(255, 248, 237, .65);
}

.hero {
  position: relative;
  isolation: isolate;
  min-height: 100vh;
  min-height: 100svh;
  padding: clamp(5.2rem, 8vw, 7.2rem) var(--gutter) clamp(1.4rem, 3vw, 2rem);
  color: var(--bone);
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 18%;
  background: linear-gradient(transparent, var(--paper));
  z-index: -1;
}

.hero-atmosphere {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  z-index: -2;
  background: var(--charcoal);
}

.hero-atmosphere img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: .72;
}

.rain-pane {
  object-position: center;
  filter: saturate(.72) contrast(1.04);
}

.kiln-pane {
  object-position: 58% center;
  filter: saturate(1.12) contrast(1.1);
}

.hero-atmosphere::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(23, 19, 17, .28), rgba(23, 19, 17, .76) 46%, rgba(216, 107, 42, .22)),
    radial-gradient(circle at 66% 38%, rgba(216, 107, 42, .24), transparent 28rem),
    linear-gradient(180deg, rgba(23, 19, 17, .42), rgba(23, 19, 17, .62));
}

.hero-content {
  width: min(100%, var(--max));
  min-height: calc(100svh - 9rem);
  margin-inline: auto;
  display: grid;
  grid-template-columns: minmax(0, .78fr) minmax(21rem, 1.22fr);
  align-items: center;
  gap: clamp(1.5rem, 4vw, 4.25rem);
}

.hero-copy {
  min-width: 0;
}

.eyebrow,
.tag,
.mono {
  margin: 0 0 .75rem;
  color: var(--kiln-ember);
  font: 700 .76rem/1.2 var(--mono);
  letter-spacing: .06em;
  text-transform: uppercase;
}

.process-section .eyebrow,
.workshops-section .eyebrow,
.commission-section .eyebrow,
.story-section .eyebrow,
.notice .mono {
  color: var(--reduction-brown);
}

h1,
h2,
h3,
p {
  margin-block-start: 0;
}

h1,
h2 {
  font-family: var(--serif);
  line-height: .98;
  text-wrap: balance;
  font-weight: 720;
}

h1 {
  max-width: 8.6ch;
  margin-block-end: 1.1rem;
  font-size: clamp(4rem, 3.45rem + 2.35vi, 7rem);
}

h2 {
  margin-block-end: 1rem;
  font-size: clamp(2.45rem, 2.05rem + 1.65vi, 4.75rem);
}

h3 {
  margin-block-end: .55rem;
  font-family: var(--serif);
  font-size: clamp(1.25rem, 1.13rem + .4vi, 1.65rem);
  line-height: 1.08;
}

.hero-lede,
.section-heading > p,
.split-heading > p,
.commission-layout > div > p,
.story-copy > p,
.shop-intro h2 {
  max-width: 62ch;
  color: currentColor;
  text-wrap: pretty;
}

.hero-lede {
  max-width: 35rem;
  margin-block-end: 1.5rem;
  color: rgba(255, 248, 237, .86);
  font-size: clamp(1.06rem, 1rem + .28vi, 1.28rem);
}

.hero-actions,
.shop-actions,
.notice-actions {
  flex-wrap: wrap;
  gap: .75rem;
}

.button {
  min-height: 3rem;
  display: inline-grid;
  place-items: center;
  padding: .88rem 1.18rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 760;
  line-height: 1.1;
  transition: transform 180ms var(--ease), background-color 180ms var(--ease), color 180ms var(--ease);
}

.button-primary {
  background: var(--kiln-ember);
  color: var(--charcoal);
  box-shadow: inset 0 0 0 1px rgba(23, 19, 17, .35), 0 10px 22px rgba(58, 33, 24, .18);
}

.button-secondary {
  color: var(--bone);
  background: rgba(23, 19, 17, .2);
  box-shadow: inset 0 0 0 2px rgba(255, 248, 237, .78);
}

.button-secondary.dark {
  color: var(--reduction-brown);
  background: rgba(255, 248, 237, .82);
  box-shadow: inset 0 0 0 2px rgba(58, 33, 24, .58);
}

.glaze-stage {
  position: relative;
  padding: clamp(1rem, 2vw, 1.7rem);
  border-radius: 2rem 1rem 1.7rem 1.2rem;
  background:
    linear-gradient(90deg, rgba(231, 215, 195, .18), rgba(23, 19, 17, .1)),
    rgba(23, 19, 17, .42);
  box-shadow: var(--shadow), inset 0 0 0 1px rgba(231, 215, 195, .18);
}

.stage-rail {
  height: .35rem;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(231, 215, 195, .36), rgba(216, 107, 42, .7));
}

.stage-rail.bottom {
  margin-block-start: 1rem;
}

.test-wall {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  grid-auto-rows: minmax(5.8rem, 1fr);
  gap: clamp(.55rem, 1.2vw, .95rem);
  padding-block: 1rem;
}

.test-tile {
  position: relative;
  min-width: 0;
  min-height: 5.8rem;
  display: flex;
  flex-direction: column;
  justify-content: end;
  gap: .16rem;
  padding: .72rem;
  overflow: hidden;
  color: var(--charcoal);
  text-decoration: none;
  border-radius: 29% 18% 25% 16% / 16% 28% 15% 24%;
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, .28),
    inset 0 -15px 24px rgba(58, 33, 24, .16),
    0 10px 20px rgba(23, 19, 17, .28);
  transform: translateZ(0);
  transition: translate 180ms var(--ease);
}

.test-tile::before,
.surface-card::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .34;
  pointer-events: none;
  background:
    radial-gradient(circle at 20% 24%, rgba(255,255,255,.36) 0 2px, transparent 2.4px),
    radial-gradient(circle at 74% 42%, rgba(58,33,24,.24) 0 1.3px, transparent 1.7px),
    radial-gradient(circle at 52% 82%, rgba(58,33,24,.18) 0 1px, transparent 1.5px);
  background-size: 33px 29px, 19px 23px, 27px 21px;
}

.test-tile::after {
  content: "";
  position: absolute;
  inset: 0 12% auto auto;
  width: 42%;
  height: 58%;
  border-radius: 0 0 999px 999px;
  background: rgba(255, 255, 255, .2);
  transform: rotate(8deg);
  transform-origin: top center;
}

.test-tile > * {
  position: relative;
  z-index: 1;
}

.test-tile strong {
  font-family: var(--serif);
  font-size: clamp(1rem, .9rem + .42vi, 1.35rem);
  line-height: 1;
  hyphens: auto;
  overflow-wrap: break-word;
}

.test-tile small,
.process-card p,
.offering-card p,
.offering-card span,
.surface-card p,
.proof-grid p,
.notice p,
.site-footer {
  color: var(--ink-soft);
}

.test-tile small {
  font-size: .78rem;
  line-height: 1.2;
}

.stamp {
  align-self: start;
  display: inline-grid;
  place-items: center;
  min-width: 2rem;
  min-height: 1.35rem;
  margin-block-end: auto;
  border: 1px solid rgba(23, 19, 17, .32);
  border-radius: 3px;
  font: 700 .65rem/1 var(--mono);
}

.tall {
  grid-row: span 2;
}

.wide {
  grid-column: span 2;
}

.ember { background: linear-gradient(145deg, #f0a25d, var(--kiln-ember) 48%, #74331e); }
.rain { background: linear-gradient(145deg, #d9e1d8, var(--rain)); }
.moss { background: linear-gradient(145deg, #a9b899, var(--moss)); color: var(--bone); }
.bisque { background: linear-gradient(145deg, #fff4df, var(--bisque)); }
.slip { background: linear-gradient(145deg, #c2967a, var(--wet-clay)); }
.shino { background: linear-gradient(145deg, #f1c18d, #a84421 64%, #2f1710); color: var(--bone); }
.celadon { background: linear-gradient(145deg, #d8e2d1, #89a184 50%, #536a58); }
.ash { background: linear-gradient(145deg, #e6e0d6, #aeb8aa 45%, #6b7770); }
.charcoal { background: linear-gradient(145deg, #4d423a, var(--charcoal)); color: var(--bone); }
.moss small,
.shino small,
.charcoal small {
  color: var(--bone);
}

.hero-footnote {
  width: min(100%, var(--max));
  margin: 0 auto;
  justify-content: space-between;
  gap: .75rem;
  flex-wrap: wrap;
  color: rgba(255, 248, 237, .8);
  font: 700 .75rem/1.2 var(--mono);
  text-transform: uppercase;
}

.process-section,
.workshops-section,
.shop-section,
.commission-section,
.story-section {
  width: min(100%, var(--max));
  margin-inline: auto;
  padding: var(--section) var(--gutter);
}

.section-heading {
  margin-block-end: clamp(1.75rem, 4vw, 3.2rem);
}

.section-heading h2,
.shop-intro h2,
.commission-layout h2,
.story-copy h2 {
  color: var(--reduction-brown);
}

.section-heading > p,
.split-heading > p,
.commission-layout > div > p,
.story-copy > p {
  color: var(--reduction-brown);
}

.split-heading,
.commission-layout,
.story-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(18rem, .72fr);
  gap: clamp(1.5rem, 4vw, 4rem);
  align-items: start;
}

.process-shell {
  display: grid;
  grid-template-columns: minmax(17rem, .42fr) minmax(0, 1fr);
  gap: clamp(1rem, 3vw, 2rem);
  align-items: stretch;
}

.process-photo,
.shelf-photo,
.story-image {
  position: relative;
  overflow: hidden;
  background: var(--reduction-brown);
  box-shadow: var(--shadow);
}

.process-photo {
  min-height: 29rem;
  border-radius: 1.8rem .8rem 1.4rem .7rem;
}

.process-photo img,
.shelf-photo img,
.story-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ring-lines {
  position: absolute;
  inset: auto 1rem 1rem auto;
  width: min(58%, 15rem);
  opacity: .48;
  color: var(--bisque);
}

.ring-lines circle {
  fill: none;
  stroke: currentColor;
  stroke-width: 1.5;
  stroke-dasharray: 8 9;
}

.process-track {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(17rem, 23rem);
  align-content: stretch;
  gap: .9rem;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: x mandatory;
  padding: .5rem .3rem 1rem;
  scrollbar-color: var(--wet-clay) rgba(58,33,24,.12);
}

.process-card {
  position: relative;
  min-height: 26rem;
  display: flex;
  flex-direction: column;
  justify-content: end;
  scroll-snap-align: start;
  padding: 1.1rem;
  border-radius: .8rem .35rem 1.1rem .45rem;
  background:
    linear-gradient(180deg, rgba(255, 248, 237, .78), rgba(231, 215, 195, .72)),
    radial-gradient(circle at 20% 12%, rgba(216,107,42,.18), transparent 42%);
  box-shadow: inset 0 0 0 1px var(--line), 0 10px 25px rgba(58, 33, 24, .12);
}

.process-card::before {
  content: "";
  position: absolute;
  left: 1rem;
  right: 1rem;
  top: 1.1rem;
  height: .38rem;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--wet-clay), var(--kiln-ember));
  opacity: .72;
}

.process-card span,
.proof-grid span,
.surface-card span {
  color: var(--reduction-brown);
  font: 700 .72rem/1 var(--mono);
  text-transform: uppercase;
}

.offering-grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: clamp(1.1rem, 2.4vw, 1.75rem);
}

.offering-card {
  grid-column: span 4;
  min-width: 0;
  display: grid;
  grid-template-rows: 12.5rem 1fr;
  overflow: hidden;
  border-radius: .85rem .35rem 1.1rem .45rem;
  background: rgba(255, 248, 237, .84);
  box-shadow: inset 0 0 0 1px var(--line), 0 14px 35px rgba(58, 33, 24, .11);
}

.offering-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.offering-card > div {
  padding: 1.22rem;
}

.offering-card span {
  display: block;
  margin-block-start: 1rem;
  font-size: .92rem;
  font-weight: 680;
}

.feature-offer {
  grid-column: span 8;
  grid-template-columns: .85fr 1fr;
  grid-template-rows: auto;
}

.workshops-section .tag {
  color: var(--reduction-brown);
}

.shop-section {
  width: 100%;
  max-width: none;
  background:
    linear-gradient(90deg, rgba(23, 19, 17, .95), rgba(58, 33, 24, .88)),
    var(--charcoal);
  color: var(--bone);
}

.shop-section > * {
  width: min(100%, var(--max));
  margin-inline: auto;
}

.shop-intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 1.5rem;
  align-items: end;
  margin-block-end: 2rem;
}

/* Span the eyebrow across both columns so auto-placement keeps the h2 in the
   flexible first column instead of pushing it (and the actions) into
   collapsed tracks. */
.shop-intro .eyebrow {
  grid-column: 1 / -1;
}

.shop-intro h2 {
  color: var(--bone);
}

.surface-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: .8rem;
  margin-block-end: 1.5rem;
}

.surface-card {
  position: relative;
  min-height: 18rem;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: end;
  padding: 1rem;
  border-radius: 1rem .45rem 1.35rem .55rem;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.2), 0 18px 45px rgba(0,0,0,.25);
}

.surface-card > * {
  position: relative;
  z-index: 2;
}

.surface-card::after {
  content: "";
  position: absolute;
  inset: 30% 0 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent, rgba(255, 248, 237, .94) 58%, rgba(255, 248, 237, .98));
}

.surface-card h3,
.surface-card p,
.surface-card span {
  color: var(--charcoal);
}

.surface-card p {
  font-weight: 620;
}

.rain-ash { background: linear-gradient(145deg, #e9eee4, #839189 58%, #4c5c53); }
.iron-slip { background: linear-gradient(145deg, #d4a47c, #8c5639 54%, #3a2118); }
.moss-celadon { background: linear-gradient(145deg, #dfe9d9, #7f9b78 56%, #4b614f); }
.ember-shino { background: linear-gradient(145deg, #f0c18c, #d86b2a 48%, #512518); }

.shelf-photo {
  min-height: clamp(19rem, 42vw, 33rem);
  border-radius: .4rem 1.5rem .55rem 1.25rem;
}

.shelf-photo figcaption {
  position: absolute;
  left: 1rem;
  bottom: 1rem;
  max-width: 34rem;
  margin: 0;
  padding: .85rem 1rem;
  border-radius: .45rem;
  background: linear-gradient(135deg, rgba(23, 19, 17, .92), rgba(58, 33, 24, .84));
  color: var(--bone);
  box-shadow: 0 14px 34px rgba(23, 19, 17, .28);
  font-weight: 700;
}

.test-note,
.notice,
.proof-grid article {
  background:
    linear-gradient(145deg, rgba(255, 248, 237, .86), rgba(231, 215, 195, .82)),
    var(--bisque);
  box-shadow: inset 0 0 0 1px var(--line), 0 14px 38px rgba(58, 33, 24, .11);
}

.test-note {
  position: relative;
  padding: 1.3rem;
  border-radius: .45rem 1.1rem .5rem .95rem;
  transform: rotate(.8deg);
}

.note-pin {
  position: absolute;
  top: -.55rem;
  left: 1.2rem;
  width: 3.4rem;
  height: 1.15rem;
  background: rgba(216, 107, 42, .72);
  transform: rotate(-4deg);
}

.test-note dl {
  display: grid;
  gap: .7rem;
  margin: 1.1rem 0 0;
}

.test-note div {
  display: grid;
  grid-template-columns: 6.5rem 1fr;
  gap: .8rem;
  padding-block: .65rem;
  border-block-start: 1px solid var(--line);
}

.test-note dt {
  font: 700 .74rem/1.2 var(--mono);
  text-transform: uppercase;
  color: var(--reduction-brown);
}

.test-note dd {
  margin: 0;
  color: var(--charcoal);
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: .9rem;
  margin-block-start: 2rem;
}

.proof-grid article {
  padding: 1rem;
  border-radius: .75rem .3rem .95rem .42rem;
}

.proof-grid p {
  color: var(--charcoal);
}

.test-note .mono {
  color: var(--reduction-brown);
}

.story-section {
  align-items: center;
}

.story-image {
  display: grid;
  min-height: clamp(26rem, 52vw, 42rem);
  border-radius: 1.4rem .45rem 1.1rem .65rem;
}

.story-copy {
  min-width: 0;
}

.notice {
  margin-block-start: 1.5rem;
  padding: 1.2rem;
  border-radius: .45rem 1rem .5rem .8rem;
}

.notice .button-secondary {
  color: var(--reduction-brown);
  background: rgba(255, 248, 237, .84);
  box-shadow: inset 0 0 0 2px rgba(58, 33, 24, .58);
}

.site-footer {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  width: min(100% - 2rem, var(--max));
  margin-inline: auto;
  padding-block: 1.2rem 2rem;
  border-block-start: 1px solid var(--line);
}

.site-footer p {
  margin: 0;
}

.site-footer a {
  font-weight: 700;
  text-decoration-thickness: .08em;
  text-underline-offset: .25em;
}

@media (hover: hover) and (pointer: fine) {
  .button:hover {
    transform: translateY(-3px);
  }

  /* GSAP leaves inline `transform` AND `translate: none` on the tiles and
     cards it animates, which silently kills a transform-based hover. The
     separate `translate` property composes with GSAP's transform, and
     !important lets it beat the inline `translate: none` GSAP parks there
     (GSAP never animates `translate` itself, so nothing fights). */
  .test-tile:hover,
  .offering-card:hover {
    translate: 0 -3px !important;
  }

  .offering-card {
    transition: translate 180ms var(--ease);
  }
}

@media (max-width: 68rem) {
  .hero-content,
  .process-shell,
  .split-heading,
  .commission-layout,
  .story-section,
  .shop-intro {
    grid-template-columns: 1fr;
  }

  .hero-content {
    min-height: auto;
    padding-block-start: 1rem;
  }

  .glaze-stage {
    width: 100%;
  }

  .offering-card,
  .feature-offer {
    grid-column: span 6;
  }

  .feature-offer {
    grid-template-columns: 1fr;
    grid-template-rows: 12rem 1fr;
  }

  .surface-strip,
  .proof-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 48rem) {
  .site-header {
    align-items: center;
  }

  .brand span:last-child {
    display: none;
  }

  .top-nav {
    overflow-x: auto;
    justify-content: start;
    scrollbar-width: none;
  }

  .top-nav::-webkit-scrollbar {
    display: none;
  }

  .top-nav a {
    padding-inline: .65rem;
  }

  .hero {
    padding-inline: .85rem;
  }

  .hero-atmosphere {
    grid-template-columns: 1fr;
  }

  .kiln-pane {
    display: none;
  }

  .hero-atmosphere::after {
    background:
      linear-gradient(180deg, rgba(23, 19, 17, .34), rgba(23, 19, 17, .74)),
      radial-gradient(circle at 78% 40%, rgba(216, 107, 42, .28), transparent 20rem);
  }

  h1 {
    max-width: 9ch;
  }

  .glaze-stage {
    padding: .75rem;
    border-radius: 1.1rem;
  }

  .test-wall {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(8.7rem, 42vw);
    grid-auto-rows: 8.8rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    padding-inline: .2rem;
  }

  .test-tile,
  .tall,
  .wide {
    grid-row: auto;
    grid-column: auto;
    scroll-snap-align: start;
  }

  .hero-footnote {
    align-items: start;
    flex-direction: column;
    color: rgba(255, 248, 237, .86);
  }

  .process-section,
  .workshops-section,
  .shop-section,
  .commission-section,
  .story-section {
    padding-inline: .9rem;
  }

  .process-photo {
    min-height: 18rem;
  }

  .process-track {
    grid-auto-columns: minmax(15.5rem, 78vw);
  }

  .process-card {
    min-height: 19rem;
  }

  .offering-card,
  .feature-offer {
    grid-column: 1 / -1;
  }

  .surface-strip,
  .proof-grid {
    grid-template-columns: 1fr;
  }

  .surface-card {
    min-height: 14rem;
  }

  .shelf-photo figcaption {
    position: static;
    max-width: none;
    border-radius: 0;
  }

  .site-footer {
    flex-direction: column;
  }
}

@media (max-width: 25rem) {
  .top-nav a {
    font-size: .72rem;
  }

  .header-cta {
    padding-inline: .7rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
  }
}
