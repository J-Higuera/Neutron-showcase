:root {
  --bg: #f5f7fa;
  --ink: #0b1220;
  --panel: #ffffff;
  --border: #dce4ee;
  --muted: #64748b;
  --accent: #18a8ff;
  --green: #17b26a;
  --amber: #f5a524;
  --soft-blue: #e9f6ff;
  --soft-green: #eaf8f1;
  --soft-amber: #fff6df;
  --shadow: 0 20px 60px rgba(15, 23, 42, 0.1), 0 8px 24px rgba(15, 23, 42, 0.06);
  --shadow-tight: 0 12px 32px rgba(15, 23, 42, 0.09);
  --font-sans: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
  --r-sm: 10px;
  --r-md: 14px;
  --r-lg: 20px;
  --container: min(100% - 32px, 1180px);
}

* {
  box-sizing: border-box;
}

html {
  color-scheme: light;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    linear-gradient(90deg, rgba(220, 228, 238, 0.45) 1px, transparent 1px) 50% 0 / min(7.7vw, 96px) 100%,
    var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
  line-height: 1.5;
  overflow-x: hidden;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input {
  font: inherit;
}

:focus-visible {
  outline: 3px solid rgba(24, 168, 255, 0.7);
  outline-offset: 3px;
}

.skip-link {
  position: fixed;
  left: 16px;
  top: 12px;
  z-index: 99;
  transform: translateY(-140%);
  border-radius: 999px;
  background: var(--ink);
  color: white;
  padding: 10px 14px;
}

.skip-link:focus {
  transform: translateY(0);
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid rgba(220, 228, 238, 0.9);
  background: rgba(245, 247, 250, 0.88);
  backdrop-filter: blur(16px);
}

.header-inner {
  width: var(--container);
  min-height: 76px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: auto minmax(220px, 1fr) auto auto;
  align-items: center;
  gap: 16px;
}

.wordmark,
.cart-chip,
.main-nav,
.header-search,
.button,
.status-pill {
  display: inline-flex;
  align-items: center;
}

.wordmark {
  gap: 10px;
  font-weight: 750;
  font-size: 1.08rem;
}

.wordmark-mark {
  display: grid;
  place-items: center;
  width: 34px;
  aspect-ratio: 1;
  border-radius: 8px;
  background: var(--ink);
  color: white;
  font-family: var(--font-mono);
  box-shadow: inset 0 -3px 0 rgba(255, 255, 255, 0.14);
}

.header-search {
  min-width: 0;
  gap: 10px;
  height: 44px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  padding-inline: 14px;
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
}

.header-search input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--ink);
}

.header-search span {
  color: var(--muted);
  font-family: var(--font-mono);
}

.main-nav {
  gap: 6px;
  color: #334155;
  font-size: 0.92rem;
  font-weight: 650;
}

.main-nav a,
.cart-chip {
  min-height: 40px;
  border-radius: 999px;
  padding: 9px 12px;
}

.main-nav a:hover,
.cart-chip:hover {
  background: white;
  box-shadow: inset 0 0 0 1px var(--border);
}

.cart-chip {
  gap: 8px;
  border: 1px solid var(--border);
  background: var(--panel);
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  font-weight: 650;
}

.cart-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
}

.section-shell {
  width: var(--container);
  margin-inline: auto;
  padding-block: clamp(56px, 9vw, 112px);
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: center;
  min-height: calc(100svh - 76px);
  padding-block: clamp(44px, 7vw, 84px);
}

.eyebrow,
.mono {
  margin: 0;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.76rem;
  font-weight: 700;
  letter-spacing: 0;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  max-width: 12ch;
  margin-bottom: 24px;
  font-size: clamp(3rem, 2.25rem + 3.4vw, 6.4rem);
  line-height: 0.94;
  letter-spacing: 0;
  text-wrap: balance;
}

.hero-subhead {
  max-width: 62ch;
  color: #334155;
  font-size: clamp(1.02rem, 0.98rem + 0.22vw, 1.2rem);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.button {
  justify-content: center;
  min-height: 48px;
  border-radius: 12px;
  padding: 13px 18px;
  font-weight: 750;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.button.primary {
  background: var(--ink);
  color: white;
  box-shadow: 0 14px 28px rgba(11, 18, 32, 0.18);
}

.button.secondary {
  border: 1px solid var(--border);
  background: white;
  color: var(--ink);
}

@media (hover: hover) {
  .button:hover {
    transform: translateY(-2px);
  }
}

.hero-proof {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

.hero-proof span {
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.74);
  padding: 8px 12px;
  color: var(--muted);
  font-size: 0.88rem;
}

.hero-proof strong {
  color: var(--ink);
  font-family: var(--font-mono);
}

.discovery-frame {
  position: relative;
  max-height: 620px;
  aspect-ratio: 1.06 / 1;
  overflow: hidden;
  border: 1px solid rgba(220, 228, 238, 0.95);
  border-radius: 22px;
  background:
    linear-gradient(135deg, rgba(24, 168, 255, 0.1), transparent 38%),
    linear-gradient(180deg, #ffffff, #eef4f9);
  box-shadow: var(--shadow);
}

.shelf-grid {
  height: 100%;
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  gap: 14px;
  padding: clamp(14px, 2.4vw, 24px);
}

.shelf-grid::before {
  content: "";
  position: absolute;
  inset: 12% -12% auto 18%;
  height: 44%;
  background: linear-gradient(90deg, transparent, rgba(24, 168, 255, 0.08), transparent);
  transform: rotate(-8deg);
  pointer-events: none;
}

.shelf-top {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  position: relative;
  z-index: 2;
}

.shelf-search {
  display: flex;
  min-width: 0;
  gap: 10px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: white;
  padding: 12px 14px;
  color: #334155;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.06);
}

.mini-rail {
  grid-column: 1 / -1;
  display: flex;
  gap: 8px;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.mini-rail span {
  flex: 0 0 auto;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.78);
  padding: 8px 10px;
  color: #475569;
  font-size: 0.78rem;
  font-weight: 700;
}

.product-card,
.checkout-panel,
.device-pair article,
.decision-card,
.coverage-grid article,
.proof-card,
.final-module,
.comparison-wrap {
  border: 1px solid rgba(220, 228, 238, 0.95);
  background: var(--panel);
  box-shadow: var(--shadow-tight);
}

.hero-product {
  grid-column: 1 / span 7;
  display: grid;
  grid-template-columns: 46% minmax(0, 1fr);
  gap: 16px;
  align-self: start;
  border-radius: 18px;
  padding: 14px;
  position: relative;
  z-index: 3;
}

.hero-product img {
  height: 100%;
  min-height: 240px;
  object-fit: cover;
  border-radius: 12px;
}

.hero-product h2 {
  margin: 8px 0 6px;
  font-size: clamp(1.25rem, 1rem + 1vw, 2rem);
  line-height: 1.05;
}

.hero-product p:not(.mono) {
  color: var(--muted);
  font-size: 0.92rem;
}

.price-row {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 12px;
  margin-top: 22px;
}

.price {
  font-family: var(--font-mono);
  font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
  font-weight: 700;
}

.rating {
  border-radius: 999px;
  background: var(--soft-amber);
  color: #8a5a00;
  padding: 6px 8px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
}

.signal-stack {
  grid-column: 8 / -1;
  display: flex;
  flex-wrap: wrap;
  align-content: start;
  gap: 8px;
  position: relative;
  z-index: 4;
}

.status-pill {
  min-height: 30px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: white;
  padding: 6px 9px;
  color: #475569;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
}

.status-pill.green {
  border-color: rgba(23, 178, 106, 0.3);
  background: var(--soft-green);
  color: #087443;
}

.status-pill.blue {
  border-color: rgba(24, 168, 255, 0.3);
  background: var(--soft-blue);
  color: #056394;
}

.status-pill.amber {
  border-color: rgba(245, 165, 36, 0.38);
  background: var(--soft-amber);
  color: #7a4b00;
}

.device-pair {
  grid-column: 1 / span 7;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  align-self: end;
  position: relative;
  z-index: 2;
}

.device-pair article {
  border-radius: 16px;
  padding: 10px;
}

.device-pair img {
  width: 100%;
  aspect-ratio: 16 / 10;
  object-fit: cover;
  border-radius: 10px;
  margin-bottom: 10px;
}

.device-pair span,
.device-pair strong {
  display: block;
  font-size: 0.82rem;
}

.device-pair strong {
  font-family: var(--font-mono);
}

.checkout-panel {
  grid-column: 7 / -1;
  grid-row: 4;
  align-self: end;
  border-radius: 18px;
  padding: 18px;
  position: relative;
  z-index: 5;
}

.checkout-panel h3 {
  margin: 6px 0 10px;
}

.checkout-panel ul {
  margin: 0;
  padding: 0;
  list-style: none;
  color: var(--muted);
  font-size: 0.86rem;
}

.checkout-panel li + li {
  margin-top: 7px;
}

.checkout-total {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 18px;
  border-top: 1px solid var(--border);
  padding-top: 14px;
  font-family: var(--font-mono);
}

.section-heading {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  gap: 24px;
  align-items: start;
  margin-bottom: 28px;
}

.section-heading h2,
.service-copy h2,
.proof-card h2,
.final-copy h2 {
  margin-bottom: 0;
  font-size: clamp(2rem, 1.62rem + 1.45vw, 3.5rem);
  line-height: 1;
  letter-spacing: 0;
  text-wrap: balance;
}

.category-rail {
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(240px, 1fr);
  gap: 14px;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scroll-snap-type: inline mandatory;
  padding: 4px 4px 18px;
}

.category-rail article {
  min-height: 190px;
  scroll-snap-align: start;
  border: 1px solid var(--border);
  border-radius: 16px;
  background:
    linear-gradient(180deg, rgba(24, 168, 255, 0.08), transparent 48%),
    white;
  padding: 18px;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
}

.category-rail span,
.decision-header span {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
}

.category-rail strong {
  display: block;
  margin: 18px 0 10px;
  font-size: 1.34rem;
  line-height: 1.1;
}

.category-rail p {
  color: #475569;
  font-size: 0.94rem;
}

.decision-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.decision-card {
  border-radius: 18px;
  padding: 16px;
}

.decision-header {
  min-height: 72px;
}

.decision-header h3 {
  margin-bottom: 4px;
  font-size: 1.38rem;
}

.tile-stack {
  display: grid;
  gap: 10px;
}

.product-tile {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 5px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #fbfdff;
  overflow: visible;
  padding: 12px 10px 12px 14px;
}

.product-tile strong,
.product-tile span,
.product-tile em,
.product-tile label {
  min-width: 0;
}

.product-tile strong {
  display: block;
  line-height: 1.18;
  overflow-wrap: break-word;
}

.product-tile span {
  color: #475569;
  font-size: 0.86rem;
}

.product-tile em {
  color: #087443;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-style: normal;
  font-weight: 700;
}

.product-tile label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 0.82rem;
  font-weight: 650;
}

.trust-strip {
  border-block: 1px solid var(--border);
  background: var(--ink);
  color: white;
}

.trust-inner {
  width: var(--container);
  margin-inline: auto;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding-block: 20px;
}

.trust-inner span {
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
  padding: 9px 12px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
}

.comparison-wrap {
  overflow-x: auto;
  border-radius: 18px;
}

.comparison-table {
  width: 100%;
  min-width: 780px;
  border-collapse: collapse;
  background: white;
}

.comparison-table caption {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.comparison-table th,
.comparison-table td {
  border-bottom: 1px solid var(--border);
  padding: 18px;
  text-align: left;
  vertical-align: top;
}

.comparison-table thead th {
  background: #f8fbff;
  color: var(--ink);
  font-size: 0.86rem;
}

.comparison-table tbody th {
  width: 24%;
  color: #334155;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  text-transform: uppercase;
}

.comparison-table td {
  color: #475569;
}

.comparison-table tbody tr:last-child th,
.comparison-table tbody tr:last-child td {
  border-bottom: 0;
}

.comparison-table tr.is-lit th,
.comparison-table tr.is-lit td {
  background: #f7fbff;
}

.service {
  display: grid;
  grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
  gap: clamp(24px, 5vw, 64px);
  align-items: center;
}

.service-media {
  border-radius: 22px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.service-media img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.coverage-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 28px;
}

.coverage-grid article {
  border-radius: 16px;
  padding: 16px;
}

.coverage-grid h3 {
  margin: 10px 0 8px;
  font-size: 1.04rem;
}

.coverage-grid p {
  color: #475569;
  font-size: 0.9rem;
}

.proof-card {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  gap: clamp(20px, 4vw, 48px);
  border-radius: 22px;
  padding: clamp(16px, 3vw, 28px);
  align-items: center;
}

.proof-card img {
  width: 100%;
  aspect-ratio: 16 / 12;
  object-fit: cover;
  border-radius: 16px;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 26px;
}

.proof-grid p {
  border-top: 2px solid var(--border);
  padding-top: 14px;
}

.proof-grid strong,
.proof-grid span {
  display: block;
}

.proof-grid span {
  margin-top: 8px;
  color: #475569;
  font-size: 0.92rem;
}

.final-cta {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.62fr);
  gap: clamp(24px, 5vw, 64px);
  align-items: center;
}

.final-module {
  border-radius: 20px;
  padding: 10px;
}

.final-module div {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid var(--border);
  padding: 14px;
}

.final-module div:last-child {
  border-bottom: 0;
}

.final-module span {
  color: var(--muted);
}

.final-module strong {
  text-align: right;
  font-family: var(--font-mono);
  font-size: 0.86rem;
}

.site-footer {
  width: var(--container);
  margin-inline: auto;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--border);
  padding-block: 26px;
  color: var(--muted);
  font-size: 0.9rem;
}

.site-footer span:first-child {
  color: var(--ink);
  font-weight: 800;
}

@media (prefers-reduced-motion: no-preference) {
  .reveal,
  .shelf-layer {
    will-change: transform, opacity;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

@media (max-width: 1060px) {
  .header-inner {
    grid-template-columns: auto minmax(160px, 1fr) auto;
  }

  .main-nav {
    display: none;
  }

  .hero,
  .service,
  .proof-card,
  .final-cta {
    grid-template-columns: 1fr;
  }

  h1 {
    max-width: 14ch;
  }

  .discovery-frame {
    max-height: none;
    aspect-ratio: auto;
  }

  .shelf-grid {
    min-height: 700px;
  }

  .decision-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 720px) {
  .header-inner {
    min-height: auto;
    grid-template-columns: 1fr auto;
    padding-block: 12px;
  }

  .header-search {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .hero {
    min-height: auto;
  }

  h1 {
    font-size: clamp(2.75rem, 2.35rem + 1.7vw, 3.5rem);
  }

  .hero-actions .button {
    width: 100%;
  }

  .section-heading,
  .proof-grid,
  .coverage-grid,
  .decision-grid {
    grid-template-columns: 1fr;
  }

  .shelf-top,
  .hero-product,
  .device-pair {
    grid-template-columns: 1fr;
  }

  .shelf-grid {
    min-height: auto;
    display: block;
  }

  .shelf-grid > * + * {
    margin-top: 12px;
  }

  .hero-product img {
    min-height: 190px;
    aspect-ratio: 16 / 10;
  }

  .signal-stack,
  .checkout-panel,
  .hero-product,
  .device-pair {
    grid-column: auto;
    grid-row: auto;
  }

  .category-rail {
    grid-auto-columns: minmax(220px, 82vw);
  }

  .final-cta {
    grid-template-columns: 1fr;
  }

  .final-module div,
  .site-footer {
    display: grid;
  }

  .final-module strong {
    text-align: left;
  }
}

@media (max-width: 420px) {
  .section-shell {
    width: min(100% - 24px, 1180px);
  }

  .wordmark span:last-child {
    display: none;
  }

  .cart-chip {
    padding-inline: 10px;
  }

  .hero-proof span,
  .trust-inner span {
