{
  "name": "aurel-v3",
  "version": "3.0.0",
  "description": "AUREL — Museum of Dimensional Craft (React Three Fiber museum for high-fidelity 3D objects)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "sync:metadata": "node scripts/sync-metadata.mjs",
    "verify:aurel": "node scripts/verify-aurel.mjs",
    "build": "npm run sync:metadata && tsc --noEmit && vite build && npm run verify:aurel",
    "preview": "vite preview --host 0.0.0.0"
  },
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.2.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.5",
    "draco3dgltf": "^1.5.7",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.0"
  }
}
