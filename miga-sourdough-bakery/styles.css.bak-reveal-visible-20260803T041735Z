:root {
  color-scheme: light;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-text: "Source Sans 3", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --flour: #fff7e8;
  --linen: #f4e7ce;
  --butter: #f3c968;
  --honey: #c78538;
  --crust: #7c431f;
  --deep-crust: #351e13;
  --olive: #66734b;
  --ink: #241810;
  --muted: #765d48;
  --shadow: 0 22px 60px rgba(74, 43, 20, .16);
  --soft-shadow: 0 12px 34px rgba(74, 43, 20, .12);
  --ease: cubic-bezier(.16, 1, .3, 1);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  overflow-x: clip;
}

body {
  margin: 0;
  overflow-x: clip;
  background:
    radial-gradient(circle at 12% 5%, rgba(243, 201, 104, .28), transparent 32rem),
    linear-gradient(180deg, var(--flour), #f8edd9 54%, #efe0c2);
  color: var(--ink);
  font-family: var(--font-text);
  font-size: 17px;
  line-height: 1.6;
  text-rendering: optimizeLegibility;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .18;
  background-image:
    linear-gradient(90deg, rgba(53, 30, 19, .06) 1px, transparent 1px),
    linear-gradient(rgba(53, 30, 19, .045) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(to bottom, #000, transparent 78%);
  z-index: -1;
}

img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

a {
  color: inherit;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  width: calc(100% - 2rem);
  max-width: 1180px;
  margin: 0 auto;
  padding: .85rem 0;
  backdrop-filter: blur(14px);
}

.brand,
nav,
.hero-actions,
.board-top,
footer {
  display: flex;
  align-items: center;
}

.brand {
  gap: .65rem;
  text-decoration: none;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
}

.brand-mark {
  display: grid;
  width: 2.15rem;
  aspect-ratio: 1;
  place-items: center;
  border-radius: 50%;
  background: var(--deep-crust);
  color: var(--flour);
  line-height: 1;
}

nav {
  gap: .35rem;
  padding: .28rem;
  border: 1px solid rgba(124, 67, 31, .17);
  border-radius: 999px;
  background: rgba(255, 247, 232, .72);
  box-shadow: 0 6px 24px rgba(74, 43, 20, .08);
}

nav a {
  padding: .45rem .75rem;
  border-radius: 999px;
  color: var(--muted);
  font-size: .86rem;
  font-weight: 600;
  text-decoration: none;
}

nav a:hover,
nav a:focus-visible {
  background: rgba(243, 201, 104, .28);
  color: var(--deep-crust);
}

.hero {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(300px, .78fr);
  gap: clamp(1.5rem, 4vw, 4.5rem);
  align-items: center;
  width: calc(100% - 2rem);
  max-width: 1220px;
  min-height: calc(100svh - 4.4rem);
  margin: 0 auto;
  padding: clamp(2.5rem, 6vw, 6rem) 0 4rem;
}

.hero-copy {
  max-width: 730px;
}

.eyebrow,
.note-kicker,
.step span,
.chalk-date {
  color: var(--olive);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2 {
  font-family: var(--font-display);
  font-weight: 650;
  line-height: .96;
  text-wrap: balance;
}

h1 {
  margin-bottom: 1.1rem;
  font-size: clamp(5rem, 4.2rem + 9vw, 13rem);
  color: var(--deep-crust);
}

h2 {
  margin-bottom: 1.15rem;
  font-size: clamp(2.35rem, 1.8rem + 2.6vw, 5.2rem);
}

h3 {
  margin-bottom: .35rem;
  font-family: var(--font-display);
  font-size: clamp(1.25rem, 1.06rem + .8vw, 2rem);
  line-height: 1.08;
}

.hero-lede {
  max-width: 620px;
  color: #4f3827;
  font-family: var(--font-display);
  font-size: clamp(1.28rem, 1.08rem + .8vw, 1.85rem);
  line-height: 1.35;
}

.hero-actions {
  flex-wrap: wrap;
  gap: .75rem;
  margin-top: 2rem;
}

.button {
  display: inline-flex;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: .78rem 1.15rem;
  font-weight: 800;
  text-decoration: none;
  transition: transform 180ms var(--ease), background 180ms var(--ease), box-shadow 180ms var(--ease);
}

.button.primary {
  background: var(--deep-crust);
  color: var(--flour);
  box-shadow: var(--soft-shadow);
}

.button.ghost {
  border: 1px solid rgba(124, 67, 31, .25);
  background: rgba(255, 247, 232, .62);
  color: var(--deep-crust);
}

.button:hover,
.button:focus-visible {
  transform: translateY(-2px);
}

.hero-photo {
  position: relative;
  min-height: min(72svh, 760px);
  margin: 0;
  overflow: hidden;
  border-radius: 46% 46% 12px 12px / 38% 38% 12px 12px;
  box-shadow: var(--shadow);
  background: var(--linen);
}

.hero-photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 48%, rgba(36, 24, 16, .28));
}

figcaption {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  max-width: 18rem;
  padding: .65rem .8rem;
  border-radius: 7px;
  background: rgba(255, 247, 232, .86);
  color: #4f3827;
  font-size: .86rem;
  line-height: 1.35;
}

.hero-note {
  position: absolute;
  right: clamp(16rem, 24vw, 25rem);
  bottom: 6rem;
  display: grid;
  gap: .12rem;
  width: min(18rem, 45vw);
  padding: 1rem;
  border: 1px solid rgba(124, 67, 31, .18);
  border-radius: 8px;
  background: rgba(255, 247, 232, .88);
  box-shadow: var(--soft-shadow);
}

.hero-note strong {
  font-family: var(--font-display);
  font-size: 1.55rem;
  line-height: 1.1;
}

.counter-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1px;
  width: calc(100% - 2rem);
  max-width: 1220px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid rgba(124, 67, 31, .18);
  border-radius: 8px;
  background: rgba(124, 67, 31, .18);
}

.counter-strip span {
  padding: .9rem .6rem;
  background: rgba(255, 247, 232, .72);
  color: var(--crust);
  font-family: var(--font-display);
  text-align: center;
}

.section {
  width: calc(100% - 2rem);
  max-width: 1220px;
  margin: 0 auto;
  padding: clamp(4.5rem, 9vw, 8rem) 0;
}

.section-heading {
  display: grid;
  grid-template-columns: .9fr 1fr;
  gap: clamp(1rem, 4vw, 5rem);
  align-items: end;
  margin-bottom: clamp(2rem, 5vw, 4rem);
}

.section-heading p:last-child {
  max-width: 42rem;
  color: var(--muted);
  font-size: clamp(1rem, .96rem + .3vw, 1.2rem);
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  align-items: stretch;
}

.step {
  position: relative;
  min-height: 480px;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: var(--soft-shadow);
  background: var(--linen);
}

.step.wide {
  grid-column: span 2;
}

.step::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 38%, rgba(36, 24, 16, .74));
}

.step div {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  left: 1rem;
  z-index: 1;
  color: var(--flour);
}

.step span {
  color: var(--butter);
}

.step p {
  max-width: 36rem;
  margin-bottom: 0;
}

.menu {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, .72fr);
  gap: clamp(1rem, 4vw, 3.5rem);
  align-items: center;
}

.menu-board {
  padding: clamp(1.2rem, 3vw, 2rem);
  border-radius: 8px;
  background: #392417;
  color: var(--flour);
  box-shadow: var(--shadow);
}

.board-top {
  justify-content: space-between;
  gap: 1rem;
}

.menu-board .eyebrow,
.chalk-date {
  color: #eecb7d;
}

.bake-list {
  display: grid;
  gap: .72rem;
  margin-top: 1.5rem;
}

.bake-item {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 1rem;
  align-items: start;
  padding: 1rem;
  border: 1px solid rgba(255, 247, 232, .17);
  border-radius: 7px;
  background: rgba(255, 247, 232, .06);
  transition: transform 180ms var(--ease), background 180ms var(--ease), border-color 180ms var(--ease);
}

.bake-item h3 {
  margin-bottom: .1rem;
}

.bake-item p,
.board-note {
  margin-bottom: 0;
  color: rgba(255, 247, 232, .76);
}

.bake-item strong {
  color: var(--butter);
  font-variant-numeric: tabular-nums;
}

.bake-item.is-warm,
.bake-item:hover {
  transform: translateY(-3px);
  border-color: rgba(243, 201, 104, .5);
  background: rgba(243, 201, 104, .13);
}

.board-note {
  margin-top: 1.25rem;
  font-style: italic;
}

.menu-photo,
.story-photo,
.crumb-photo {
  position: relative;
  margin: 0;
  overflow: hidden;
  border-radius: 8px;
  box-shadow: var(--soft-shadow);
  background: var(--linen);
}

.menu-photo {
  min-height: 620px;
}

.story {
  display: grid;
  grid-template-columns: minmax(260px, .64fr) minmax(0, 1fr);
  gap: clamp(1.5rem, 5vw, 5rem);
  align-items: center;
}

.story-photo {
  min-height: 700px;
  border-radius: 999px 999px 8px 8px;
}

.story-copy p:not(.eyebrow),
.crumb-copy p,
.pickup-panel p {
  max-width: 46rem;
  color: var(--muted);
}

.proof-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: .8rem;
  margin: 2rem 0 0;
}

.proof-list div,
.pickup-card {
  padding: 1rem;
  border: 1px solid rgba(124, 67, 31, .18);
  border-radius: 8px;
  background: rgba(255, 247, 232, .58);
}

dt {
  font-weight: 850;
}

dd {
  margin: .2rem 0 0;
  color: var(--muted);
}

.crumb-section {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(280px, .78fr);
  gap: clamp(1.25rem, 5vw, 5rem);
  align-items: center;
}

.crumb-photo {
  min-height: 660px;
  transform: rotate(1.2deg);
}

.pickup {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, .42fr);
  gap: 1rem;
  align-items: stretch;
  padding-bottom: clamp(3rem, 7vw, 5rem);
}

.pickup-panel {
  padding: clamp(1.4rem, 4vw, 3rem);
  border-radius: 8px;
  background:
    linear-gradient(135deg, rgba(243, 201, 104, .45), transparent 44%),
    #fff2d5;
  box-shadow: var(--soft-shadow);
}

.pickup-card {
  display: grid;
  align-content: center;
}

.pickup-card ul {
  margin: .75rem 0 0;
  padding-left: 1.1rem;
  color: var(--muted);
}

footer {
  justify-content: space-between;
  gap: 1rem;
  width: calc(100% - 2rem);
  max-width: 1220px;
  margin: 0 auto;
  padding: 1.5rem 0 2rem;
  border-top: 1px solid rgba(124, 67, 31, .2);
  color: var(--muted);
}

footer p {
  margin-bottom: 0;
}

footer a {
  font-weight: 800;
  text-decoration-thickness: .08em;
  text-underline-offset: .22em;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

@media (prefers-reduced-motion: no-preference) {
  .motion-ready .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms var(--ease), transform 700ms var(--ease);
    transition-delay: var(--delay, 0ms);
  }

  .motion-ready .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (hover: hover) {
  .step img,
  .menu-photo img,
  .story-photo img,
  .crumb-photo img {
    transition: transform 900ms var(--ease);
  }

  .step:hover img,
  .menu-photo:hover img,
  .story-photo:hover img,
  .crumb-photo:hover img {
    transform: scale(1.035);
  }
}


@media (min-width: 1400px) {
  .site-header,
  .hero,
  .counter-strip,
  .section,
  footer {
    width: calc(100% - clamp(3rem, 6vw, 7rem));
    max-width: min(92vw, 1680px);
  }

  .hero {
    grid-template-columns: minmax(520px, .95fr) minmax(520px, .86fr) minmax(220px, .36fr);
    gap: clamp(2rem, 3vw, 4rem);
    min-height: min(860px, calc(100svh - 4.4rem));
    padding: clamp(3rem, 5vw, 5.5rem) 0 clamp(2.5rem, 4vw, 4rem);
  }

  .hero-copy {
    max-width: 820px;
  }

  h1 {
    font-size: clamp(8rem, 9vw, 15rem);
  }

  .hero-lede {
    max-width: 720px;
  }

  .hero-photo {
    min-height: clamp(560px, 40vw, 740px);
  }

  .hero-note {
    position: relative;
    right: auto;
    bottom: auto;
    width: auto;
    align-self: end;
    margin-bottom: clamp(1rem, 5vw, 5rem);
  }

  .counter-strip {
    margin-top: clamp(1rem, 2vw, 2rem);
  }

  .process-grid {
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .step {
    min-height: 520px;
  }

  .step.wide {
    grid-column: span 2;
  }

  .menu {
    grid-template-columns: minmax(0, 1.18fr) minmax(420px, .82fr);
  }

  .menu-photo {
    min-height: 700px;
  }

  .story {
    grid-template-columns: minmax(360px, .56fr) minmax(0, 1.08fr);
  }

  .crumb-section {
    grid-template-columns: minmax(0, 1.08fr) minmax(420px, .72fr);
  }
}

@media (max-width: 920px) {
  .hero,
  .menu,
  .story,
  .crumb-section,
  .pickup,
  .section-heading {
    grid-template-columns: 1fr;
  }

  .hero {
    min-height: auto;
    padding-top: 2rem;
  }

  .hero-photo,
  .menu-photo,
  .story-photo,
  .crumb-photo {
    min-height: auto;
    aspect-ratio: 4 / 5;
  }

  .hero-note {
    position: static;
    width: auto;
    order: 3;
  }

  .process-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .step,
  .step.wide {
    grid-column: auto;
    min-height: 430px;
  }

  .proof-list {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  body {
    font-size: 16px;
  }

  .site-header {
    align-items: flex-start;
    flex-wrap: wrap;
    width: calc(100% - 1rem);
    gap: .5rem;
  }

  nav {
    width: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: .1rem;
    padding: .18rem;
  }

  nav a {
    flex: 1 1 0;
    padding: .42rem .55rem;
    font-size: .82rem;
    text-align: center;
    white-space: nowrap;
  }

  h1 {
    font-size: clamp(3.8rem, 22vw, 6.5rem);
  }

  .hero-lede {
    max-width: 20.75rem;
    font-size: 1.18rem;
  }

  .hero-copy .eyebrow {
    max-width: 20.75rem;
  }

  .button {
    flex: 0 1 auto;
    width: min(100%, 22rem);
    min-height: 2.85rem;
    padding: .72rem .95rem;
    font-size: .96rem;
  }

  .hero-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .counter-strip {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 4rem 0;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .step {
    min-height: 410px;
  }

  .bake-item {
    padding: .85rem;
  }

  figcaption {
    position: static;
    max-width: none;
    margin: .75rem;
  }

  footer {
    align-items: flex-start;
    flex-direction: column;
  }
}
